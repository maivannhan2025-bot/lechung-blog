---
// Trang chủ Vận tải Lê Chung — VIẾT LẠI theo 16 BƯỚC BÁN HÀNG (Phạm Thành Long).
// Thương hiệu Lê Chung (KHÔNG bịa số liệu/lời khách). Menu dùng chung + bảng giá + blog.
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import trangchu from '../data/trangchu.json';
import chung from '../data/chung.json';

const HOTLINE = chung.hotline;
const TEL = chung.tel;

// Khung ảnh/video đầu trang — anh Nhận tự đổi ở /admin (mục "Trang chủ").
// Có link YouTube => khung chiếu VIDEO; ô link để trống => khung hiện ẢNH.
function youtubeEmbed(url){
  if(!url) return '';
  const u = String(url).trim();
  let m;
  const id =
    (m = u.match(/[?&]v=([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/youtu\.be\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/embed\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/shorts\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/^([A-Za-z0-9_-]{11})$/)) ? m[1] : '';
  return id ? 'https://www.youtube-nocookie.com/embed/' + id : '';
}
const heroVideoUrl = youtubeEmbed(trangchu && trangchu.heroVideo);
const heroAnh = (trangchu && trangchu.heroAnh) || '/img/doi-xe.webp';
const heroEyebrow = trangchu.heroEyebrow;
const heroH1 = trangchu.heroH1;
const heroLead = trangchu.heroLead;
const heroTicks = trangchu.heroTicks || [];
const heroBtnGia = trangchu.heroBtnGia;
const dichVuTag = trangchu.dichVuTag;
const dichVuTitle = trangchu.dichVuTitle;
const dichVuIntro = trangchu.dichVuIntro;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf()
);
const norm = (s) => (s || '').toLowerCase();
function matchPost(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return '/blog/' + hit.id;
  }
  return posts.length ? '/blog/' + posts[0].id : '/blog';
}
function findId(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return hit.id;
  }
  return null;
}
function areaHref(a) {
  if (posts.find((p) => p.id === a.slug)) return '/blog/' + a.slug;
  const id = findId(a.kw);
  return id ? '/blog/' + id : '#khu-vuc';
}
const teaserPosts = posts.slice(0, 3);

// BƯỚC 3 — Nỗi đau
const noiDau = [
  { t: 'Giao Hàng Chậm Trễ', d: 'Hàng đến nơi trễ hẹn làm đứt gãy sản xuất và mất uy tín với đối tác của bạn.' },
  { t: 'Hàng Hoá Hư Hỏng', d: 'Bốc xếp và vận chuyển cẩu thả dẫn đến móp méo, vỡ nát hàng giá trị cao.' },
  { t: 'Chi Phí Phát Sinh', d: 'Báo giá mập mờ lúc đầu, sau đó cộng thêm hàng loạt khoản phí ẩn không báo trước.' },
  { t: 'Thiếu Xe Mùa Cao Điểm', d: 'Cần gấp mà không tìm được xe đúng tải, nhất là dịp lễ Tết hay đơn hàng đột xuất.' },
];

// BƯỚC 4 — Uy tín người bán
const uyTin = [
  { t: 'Pháp nhân rõ ràng', d: 'CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG — MST 0314664033, địa chỉ và hợp đồng minh bạch, không phải xe trôi nổi.' },
  { t: 'Đội xe sở hữu hơn 100 chiếc', d: 'Xe 8 – 20 tấn, xe cẩu và container/đầu kéo đều là xe của Lê Chung — chủ động điều phối, không phụ thuộc xe thuê ngoài.' },
  { t: 'Hợp đồng + hóa đơn VAT', d: 'Mọi chuyến đều có hợp đồng vận chuyển và hóa đơn GTGT (VAT) hợp lệ, chứng từ giao nhận đầy đủ để đối soát.' },
  { t: 'Định vị GPS 24/7', d: 'Toàn bộ xe gắn GPS, theo dõi hành trình theo thời gian thực — hàng của bạn luôn nằm trong tầm mắt.' },
];

// BƯỚC 5 — Before / After
const truoc = ['Gọi nhiều nơi mới có xe, lại không đúng tải', 'Giá báo một đằng, thanh toán một nẻo', 'Hàng tới trễ, móp vỡ mà không ai chịu trách nhiệm', 'Không hợp đồng, không hóa đơn, khó đối soát'];
const sau = ['Một cuộc gọi là có xe đúng loại hàng', 'Báo giá trọn gói, rõ ràng từ đầu', 'Hàng đúng hẹn, nguyên vẹn, có người chịu trách nhiệm', 'Hợp đồng + hóa đơn VAT minh bạch'];

// BƯỚC 6 — Lợi ích (tính năng → nghĩa là bạn được)
const loiIch = [
  { t: 'Đội xe đa tải trọng, sở hữu riêng', d: 'Từ xe 8 tấn tới container/đầu kéo đều là xe của Lê Chung — nghĩa là bạn luôn có đúng xe cho loại hàng của mình, không phải chờ, không chia nhỏ hàng, không trả cước thừa.' },
  { t: 'Định vị GPS theo dõi 24/7', d: 'Mọi xe đều gắn GPS — nghĩa là bạn chủ động biết hàng đang ở đâu, tới lúc nào để báo người nhận chuẩn bị, khỏi gọi hỏi tài xế liên tục.' },
  { t: 'Cước minh bạch, ổn định', d: 'Báo giá trọn gói, giữ giá cả mùa cao điểm — nghĩa là bạn dễ tính chi phí, không lo bị hét giá hay cộng phí ẩn giữa chừng.' },
  { t: 'Bốc xếp chuyên nghiệp, có xe nâng', d: 'Đội bốc xếp được đào tạo, có xe nâng chuyên dụng — nghĩa là hàng lên xuống nhanh và an toàn, bạn đỡ tốn công người và giảm rủi ro móp vỡ.' },
];

// BƯỚC 6 (tiếp) — Dịch vụ / đội xe
const dichVuKeys = [
  ['8 tấn','tải trọng','loại xe'],
  ['10 tấn','tải trọng','loại xe'],
  ['15 tấn','nguyên chuyến','đi tỉnh'],
  ['20 tấn','container','nguyên chuyến'],
  ['cẩu','bốc xếp','nâng hạ'],
  ['container','đầu kéo','cảng','nguyên chuyến'],
];
const dichVu = (trangchu.dichVu || []).map((d, i) => ({ ...d, key: dichVuKeys[i] || [] }));

const khuVuc = [
  { ten: 'TP. Hồ Chí Minh', slug: 'van-chuyen-hang-hoa-noi-thanh-tphcm', kw: ['nội thành', 'tphcm', 'hồ chí minh', 'sài gòn'] },
  { ten: 'Miền Đông Nam Bộ', slug: 'van-chuyen-hang-di-mien-dong-nam-bo', kw: ['miền đông', 'đồng nai', 'bình dương', 'vũng tàu'] },
  { ten: 'Miền Tây Nam Bộ', slug: 'van-chuyen-hang-di-mien-tay', kw: ['miền tây', 'cần thơ', 'long an', 'tiền giang'] },
  { ten: 'Tây Nguyên', slug: 'van-chuyen-hang-di-tay-nguyen', kw: ['tây nguyên', 'đắk lắk', 'gia lai', 'lâm đồng', 'pleiku'] },
  { ten: 'Miền Trung', slug: 'van-chuyen-hang-di-mien-trung', kw: ['miền trung', 'đà nẵng', 'huế', 'quy nhơn', 'nha trang'] },
  { ten: 'Miền Bắc', slug: 'van-chuyen-hang-di-mien-bac', kw: ['miền bắc', 'hà nội', 'hải phòng'] },
];

// BƯỚC 8 — Quy trình rõ ràng
const quyTrinh = [
  { s: '01', t: 'Gọi & khảo sát', d: 'Bạn gọi ' + HOTLINE + ', mô tả hàng. Chúng tôi tư vấn loại xe phù hợp nhất.' },
  { s: '02', t: 'Báo giá & chốt', d: 'Nhận báo giá trọn gói rõ ràng, thống nhất phương án và ký hợp đồng.' },
  { s: '03', t: 'Điều xe & giám sát', d: 'Điều xe đúng hẹn lấy hàng, giám sát hành trình GPS liên tục, an toàn tuyệt đối.' },
  { s: '04', t: 'Giao & xác nhận', d: 'Giao đúng tiến độ, nghiệm thu nguyên vẹn, hoàn tất chứng từ và hóa đơn VAT.' },
];

// BƯỚC 9 — Giá trị lớn (lợi ích của lợi ích)
const giaTriLon = [
  { t: 'Tiết kiệm thời gian điều phối', d: 'Một cuộc gọi là có xe đúng tải, khỏi mất buổi đi tìm và trả giá với nhiều nhà xe.' },
  { t: 'Tránh rủi ro & chi phí đền bù', d: 'Hàng đi an toàn, có bảo hiểm và cam kết bồi thường — bạn không phải gánh thiệt hại khi có sự cố.' },
  { t: 'Giữ uy tín với khách của bạn', d: 'Giao đúng hẹn giúp bạn giữ lời với đối tác — thứ còn quý hơn cả tiền cước.' },
  { t: 'Rảnh tay lo việc kinh doanh', d: 'Khâu vận chuyển có người lo tới nơi, bạn tập trung vào bán hàng và sản xuất.' },
];

// BƯỚC 10 — Xử lý từ chối
const objections = [
  { q: 'Tôi sợ báo một giá rồi lúc thanh toán lại phát sinh thêm?', a: 'Lê Chung báo giá trọn gói và ghi rõ đã gồm những gì trước khi xe chạy — không phí ẩn. Có hợp đồng và hóa đơn GTGT (VAT) đầy đủ để bạn đối soát minh bạch.' },
  { q: 'Lỡ hàng hư hỏng hoặc thất lạc thì sao?', a: 'Mọi chuyến đều có thể mua bảo hiểm hàng hóa 100% giá trị theo quy định. Nếu hư hỏng do quá trình vận chuyển, Lê Chung cam kết bồi thường — bạn không chịu thiệt một mình.' },
  { q: 'Tôi cần xe gấp, có kịp không?', a: 'Đội hơn 100 xe luôn có xe trực. Nội thành TP.HCM thường có mặt sau khoảng 30 phút; đi tỉnh chỉ cần đặt trước 1–2 ngày để giữ đúng chuyến bạn cần.' },
  { q: 'Thời gian giao hàng liên tỉnh mất bao lâu?', a: 'Tùy tuyến: đi miền Trung khoảng 1–2 ngày, miền Bắc khoảng 3–4 ngày. Chúng tôi cam kết đúng tiến độ đã thỏa thuận và cho bạn theo dõi hành trình qua GPS.' },
  { q: 'Tôi cần chuẩn bị thông tin gì để nhận báo giá?', a: 'Chỉ cần cho biết: loại hàng, khối lượng/kích thước, điểm lấy và điểm giao. Gọi ' + HOTLINE + ', chuyên viên tính lộ trình và báo giá tối ưu ngay.' },
];

// BƯỚC 11 — Lý do mua (sứ mệnh)
const truCot = [
  { t: 'Đúng giờ', d: 'Giữ đúng lịch đã hẹn, vì trễ một chuyến là ảnh hưởng cả việc của bạn.' },
  { t: 'Đúng giá', d: 'Báo sao thu vậy, trọn gói, không hét giá, không phí ẩn.' },
  { t: 'Có trách nhiệm', d: 'Theo hàng tới cùng, có sự cố là có người đứng ra xử lý và bồi thường.' },
];

// BƯỚC 13 — Bảng giá tham khảo (đã +1%, anh Nhận đã duyệt)
const bangGia = trangchu.bangGia || [];

// BƯỚC 14 — Quà tặng / cam kết thêm
const quaTang = trangchu.quaTang || [];

// BƯỚC 15 — Testimonial (lời khách; anh Nhận thay bằng khách thật khi có)
const danhGia = trangchu.danhGia || [];
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung {HOTLINE}</title>
<meta name="description" content={`Thuê xe tải chở hàng TP.HCM đi toàn quốc — Vận Tải Lê Chung: đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Báo giá miễn phí ${HOTLINE}.`}>
<link rel="canonical" href="https://lechung.vn/">
<meta property="og:title" content="Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung">
<meta property="og:description" content={`Đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Hotline ${HOTLINE}.`}>
<meta property="og:type" content="website">
<style is:global>
  :root{
    --bg:#f2f5fa; --panel:#ffffff; --card:#ffffff; --line:#dbe3ee;
    --text:#0a2540; --text-soft:#33475f; --muted:#647388;
    --brand:#ff6b35; --brand-dark:#e5541f; --brand-tint:#fff1ea;
    --navy:#0a2540; --navy-2:#15324d; --danger:#d0483a;
    --shadow:0 1px 2px rgba(10,37,64,.06),0 8px 30px rgba(10,37,64,.08);
    --radius:14px;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --bg:#061626; --panel:#0c2033; --card:#0f2942; --line:#234260;
      --text:#eaf1fa; --text-soft:#bcccdd; --muted:#8395aa;
      --brand:#ff7a45; --brand-dark:#ff9468; --brand-tint:#2a160c;
      --navy:#04101c; --navy-2:#15324d; --danger:#e06a5c;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 34px rgba(0,0,0,.45);
    }
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif; line-height:1.6; -webkit-font-smoothing:antialiased}
  .wrap{max-width:1120px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  img{max-width:100%; display:block}
  .tnum{font-variant-numeric:tabular-nums}
  .eyebrow{color:var(--brand); font-weight:800; font-size:13.5px; letter-spacing:.08em; text-transform:uppercase; margin:0 0 8px}
  .step-tag{display:inline-block; color:var(--brand-dark); background:var(--brand-tint); font-weight:800; font-size:12px; letter-spacing:.04em; padding:4px 10px; border-radius:999px; margin:0 0 10px}
  .sec-title{font-size:clamp(23px,3.4vw,33px); font-weight:800; letter-spacing:-.015em; margin:0 0 14px; line-height:1.2}
  .btn-call{display:inline-flex; align-items:center; gap:9px; background:var(--brand); color:#fff; text-decoration:none; font-weight:800; font-size:16px; padding:13px 26px; border-radius:11px; box-shadow:0 8px 22px rgba(255,107,53,.32); border:0; cursor:pointer}
  .btn-call:hover{background:var(--brand-dark)}

  /* HERO — Bước 1+2 */
  .hero{background:linear-gradient(160deg,var(--navy),var(--navy-2)); color:#fff; overflow:hidden}
  .hero .wrap{display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-items:center; padding-top:52px; padding-bottom:52px}
  .hero .eyebrow{color:#ffb59a}
  .hero h1{font-size:clamp(28px,4.4vw,46px); font-weight:900; line-height:1.1; letter-spacing:-.02em; margin:0 0 16px; text-wrap:balance}
  .hero p.lead{color:#c7d3e2; font-size:16.5px; margin:0 0 20px; max-width:560px}
  .hero .ticks{list-style:none; margin:0 0 24px; padding:0; display:grid; gap:8px; max-width:540px}
  .hero .ticks li{position:relative; padding-left:28px; color:#dbe6f2; font-size:15px; font-weight:600}
  .hero .ticks li::before{content:'✓'; position:absolute; left:0; top:-1px; width:20px;height:20px; background:var(--brand); color:#fff; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:900}
  .hero-cta{display:flex; gap:12px; flex-wrap:wrap; align-items:center}
  .hero-cta .ghost{display:inline-flex; align-items:center; gap:8px; color:#fff; text-decoration:none; font-weight:800; font-size:15px; padding:12px 22px; border-radius:11px; border:1.5px solid rgba(255,255,255,.35)}
  .hero-cta .ghost:hover{background:rgba(255,255,255,.1); border-color:#fff}
  .hero-photo{border-radius:18px; box-shadow:0 20px 50px rgba(0,0,0,.4); width:100%; height:100%; object-fit:cover; aspect-ratio:4/3}
  .hero-video{position:relative; width:100%; aspect-ratio:16/9; border-radius:18px; overflow:hidden; box-shadow:0 20px 50px rgba(0,0,0,.4); background:#000}
  .hero-video iframe{position:absolute; inset:0; width:100%; height:100%; border:0}
  @media(max-width:820px){
    .hero .wrap{grid-template-columns:1fr; gap:26px; padding-top:36px; padding-bottom:38px; text-align:center}
    .hero .eyebrow{margin-left:auto;margin-right:auto}
    .hero p.lead{margin-left:auto;margin-right:auto}
    .hero .ticks{margin-left:auto;margin-right:auto; text-align:left; display:inline-grid}
    .hero-cta{justify-content:center}
    .hero-photo{aspect-ratio:16/10}
  }
  /* badges */
  .badges{background:var(--brand); color:#fff}
  .badges .wrap{display:flex; flex-wrap:wrap; justify-content:center; gap:10px 34px; padding:14px 20px; font-weight:800; font-size:14.5px; text-align:center}
  .badges span{display:inline-flex; align-items:center; gap:8px}
  .badges span::before{content:'✓'; font-weight:900}

  section{padding:52px 0}
  .center{text-align:center; max-width:680px; margin:0 auto 34px}

  .grid4{display:grid; grid-template-columns:repeat(4,1fr); gap:16px}
  @media(max-width:900px){.grid4{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:520px){.grid4{grid-template-columns:1fr}}
  .adv-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px}
  @media(max-width:640px){.adv-grid{grid-template-columns:1fr}}

  /* pain / value cards */
  .pain{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow)}
  .pain .ic{width:46px;height:46px;border-radius:12px;background:var(--brand-tint);color:var(--brand-dark);display:grid;place-items:center;margin-bottom:12px}
  .pain h3{margin:0 0 7px; font-size:16.5px; font-weight:800}
  .pain p{margin:0; color:var(--text-soft); font-size:14px}

  /* advantages / uy tín / lợi ích */
  .adv{display:flex; gap:14px; align-items:flex-start; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; box-shadow:var(--shadow)}
  .adv .ic{flex:0 0 auto; width:44px;height:44px;border-radius:11px;background:var(--navy);color:#fff;display:grid;place-items:center}
  .adv h3{margin:0 0 5px; font-size:16px; font-weight:800}
  .adv p{margin:0; color:var(--text-soft); font-size:14px}

  /* before / after — Bước 5 */
  .ba{display:grid; grid-template-columns:1fr 1fr; gap:20px}
  @media(max-width:720px){.ba{grid-template-columns:1fr}}
  .ba .col{border-radius:16px; padding:26px; border:1px solid var(--line); background:var(--card); box-shadow:var(--shadow)}
  .ba .before{border-top:4px solid var(--danger)}
  .ba .after{border-top:4px solid var(--brand)}
  .ba .col h3{margin:0 0 14px; font-size:18px; font-weight:800}
  .ba ul{margin:0; padding:0; list-style:none}
  .ba li{position:relative; padding-left:28px; margin-bottom:11px; color:var(--text-soft); font-size:14.5px}
  .ba .before li::before{content:'✕'; position:absolute; left:0; color:var(--danger); font-weight:900}
  .ba .after li::before{content:'✓'; position:absolute; left:0; color:var(--brand); font-weight:900}

  /* services */
  .svc-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
  @media(max-width:900px){.svc-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.svc-grid{grid-template-columns:1fr}}
  .svc{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); display:flex; flex-direction:column}
  .svc img{width:100%; aspect-ratio:16/10; object-fit:cover}
  .svc .body{padding:18px 18px 20px; display:flex; flex-direction:column; flex:1}
  .svc h3{margin:0 0 10px; font-size:17px; font-weight:800}
  .svc ul{margin:0 0 16px; padding:0; list-style:none; flex:1}
  .svc li{position:relative; padding-left:22px; margin-bottom:7px; font-size:14px; color:var(--text-soft)}
  .svc li::before{content:'✓'; position:absolute; left:0; color:var(--brand); font-weight:900}
  .svc .foot{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .svc a.more{display:inline-flex; gap:7px; align-items:center; background:var(--brand-tint); color:var(--brand-dark); text-decoration:none; font-weight:800; font-size:14px; padding:9px 15px; border-radius:9px}
  .svc a.more:hover{background:var(--brand); color:#fff}
  .svc a.readmore{color:var(--brand-dark); font-weight:800; font-size:13.5px; text-decoration:none}
  .svc a.readmore:hover{text-decoration:underline}

  /* area */
  .area{background:var(--navy); color:#fff}
  .area .chips{display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:18px}
  .area .chips span,
  .area .chips a{background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18); padding:9px 16px; border-radius:999px; font-weight:700; font-size:14.5px; color:#fff; text-decoration:none; transition:background .15s, border-color .15s}
  .area .chips a:hover{background:var(--brand); border-color:var(--brand)}

  /* emotion banner — Bước 7 */
  .emotion{background:linear-gradient(160deg,var(--navy),var(--navy-2)); color:#fff; border-radius:20px; padding:44px 30px; text-align:center}
  .emotion p{max-width:740px; margin:0 auto; font-size:clamp(18px,2.6vw,24px); font-weight:700; line-height:1.5; color:#eaf1fa; text-wrap:balance}
  .emotion .small{font-size:15px; font-weight:600; color:#c7d3e2; margin-top:14px}

  /* process */
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:16px}
  @media(max-width:820px){.steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:480px){.steps{grid-template-columns:1fr}}
  .step{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow)}
  .step .n{width:44px;height:44px;border-radius:12px;background:var(--brand);color:#fff;font-weight:900;display:grid;place-items:center;font-size:17px;margin-bottom:12px}
  .step h3{margin:0 0 6px; font-size:16px; font-weight:800}
  .step p{margin:0; color:var(--text-soft); font-size:13.8px}

  /* pillars — Bước 11 */
  .pillars{display:grid; grid-template-columns:repeat(3,1fr); gap:16px}
  @media(max-width:720px){.pillars{grid-template-columns:1fr}}
  .pillar{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:26px 22px; text-align:center; box-shadow:var(--shadow)}
  .pillar .big{font-size:20px; font-weight:900; color:var(--brand); margin:0 0 6px}
  .pillar p{margin:0; color:var(--text-soft); font-size:14px}

  /* scarcity — Bước 12 */
  .scarcity{background:var(--brand-tint); border:1px solid var(--brand); border-radius:16px; padding:26px 24px; display:flex; gap:18px; align-items:flex-start}
  .scarcity .ic{flex:0 0 auto; width:46px;height:46px;border-radius:12px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:900;font-size:20px}
  .scarcity h3{margin:0 0 6px; font-size:18px; font-weight:800}
  .scarcity p{margin:0; color:var(--text-soft); font-size:14.5px}

  /* pricing — Bước 13 */
  .price-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); background:var(--card)}
  table.price{width:100%; border-collapse:collapse; min-width:640px; font-size:14.5px}
  table.price thead th{background:var(--navy); color:#fff; font-weight:800; padding:14px 16px; text-align:center; font-size:14px}
  table.price thead th:first-child{text-align:left}
  table.price tbody td{padding:13px 16px; border-top:1px solid var(--line); text-align:center; color:var(--text-soft)}
  table.price tbody td:first-child{text-align:left; font-weight:700; color:var(--text)}
  table.price tbody tr:nth-child(even){background:color-mix(in srgb,var(--brand-tint) 45%, transparent)}
  table.price .money{font-weight:800; color:var(--brand-dark); font-variant-numeric:tabular-nums}
  table.price tbody td.tg{color:var(--muted); font-size:13px}
  .price-note{margin:16px auto 0; max-width:820px; color:var(--muted); font-size:13.5px; text-align:center}
  .price-note b{color:var(--text-soft)}
  .price-cta{text-align:center; margin-top:22px}
  .swipe-hint{display:none}
  @media(max-width:560px){
    table.price{min-width:520px; font-size:13px}
    table.price thead th{padding:12px 10px; font-size:12.5px}
    table.price tbody td{padding:11px 10px}
    .swipe-hint{display:block; text-align:center; color:var(--muted); font-size:12.5px; margin:0 0 10px}
  }
  .value-line{text-align:center; max-width:760px; margin:0 auto 26px; font-size:17px; color:var(--text-soft)}
  .value-line b{color:var(--text)}

  /* bonus — Bước 14 */
  .bonus{background:linear-gradient(160deg,var(--navy),var(--navy-2)); color:#fff; border-radius:20px; padding:36px 30px}
  .bonus .sec-title{color:#fff}
  .bonus ul{margin:16px 0 0; padding:0; list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:12px 26px}
  @media(max-width:640px){.bonus ul{grid-template-columns:1fr}}
  .bonus li{position:relative; padding-left:32px; font-size:15px; color:#dbe6f2; line-height:1.5}
  .bonus li::before{content:'✓'; position:absolute; left:0; top:0; width:22px;height:22px; background:var(--brand); color:#fff; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:900}

  /* testimonials */
  .rev-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
  @media(max-width:900px){.rev-grid{grid-template-columns:1fr}}
  .rev{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow); display:flex; flex-direction:column}
  .rev .stars{color:#ffb400; font-size:15px; letter-spacing:2px; margin-bottom:10px}
  .rev p{margin:0 0 16px; font-size:14.5px; color:var(--text-soft); flex:1}
  .rev .who{display:flex; align-items:center; gap:12px}
  .rev .who img{width:46px;height:46px;border-radius:50%; object-fit:cover}
  .rev .who b{font-size:14.5px}
  .rev .who small{color:var(--muted); font-size:12.5px}

  /* blog teaser */
  .blog-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
  @media(max-width:900px){.blog-grid{grid-template-columns:1fr}}
  .bcard{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow); display:flex; flex-direction:column}
  .bcard .tag{color:var(--brand); font-weight:800; font-size:12px; letter-spacing:.06em; text-transform:uppercase; margin:0 0 8px}
  .bcard h3{margin:0 0 8px; font-size:16.5px; font-weight:800; line-height:1.35}
  .bcard h3 a{text-decoration:none}
  .bcard h3 a:hover{color:var(--brand-dark)}
  .bcard p{margin:0 0 14px; color:var(--text-soft); font-size:14px; flex:1}
  .bcard .more{color:var(--brand-dark); font-weight:800; font-size:14px; text-decoration:none}
  .bcard .more:hover{text-decoration:underline}
  .blog-all{text-align:center; margin-top:26px}
  .blog-all a{display:inline-flex; align-items:center; gap:8px; color:var(--brand-dark); font-weight:800; text-decoration:none; border:1.5px solid var(--brand); padding:11px 22px; border-radius:11px}
  .blog-all a:hover{background:var(--brand); color:#fff}

  /* faq / objections */
  .faq{max-width:820px; margin:0 auto}
  .faq details{background:var(--card); border:1px solid var(--line); border-radius:12px; padding:0; margin-bottom:12px; box-shadow:var(--shadow); overflow:hidden}
  .faq summary{cursor:pointer; list-style:none; padding:18px 20px; font-weight:800; font-size:15.5px; display:flex; justify-content:space-between; gap:14px; align-items:center}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+'; color:var(--brand); font-size:22px; font-weight:400; flex:0 0 auto}
  .faq details[open] summary::after{content:'−'}
  .faq .ans{padding:0 20px 18px; color:var(--text-soft); font-size:14.5px}

  /* final cta — Bước 16 */
  .final{background:linear-gradient(160deg,var(--brand),#ff8659); color:#fff; border-radius:20px; padding:44px 30px; text-align:center}
  .final h2{margin:0 0 10px; font-size:clamp(24px,3.6vw,34px); font-weight:900}
  .final p{margin:0 0 22px; font-size:16px; opacity:.95}
  .final .btn-call{background:#fff; color:var(--brand-dark); box-shadow:0 10px 26px rgba(0,0,0,.18)}
  .final .btn-call:hover{background:#0a2540; color:#fff}

  /* footer */
  .site-foot{background:var(--navy); color:#c7d3e2; padding:38px 0 30px; font-size:14px}
  .site-foot .cols{display:flex; flex-wrap:wrap; gap:24px 60px; justify-content:space-between}
  .site-foot b.brand{color:#fff; font-size:16px; display:block; margin-bottom:8px}
  .site-foot a{color:#c7d3e2; text-decoration:none}
  .site-foot a:hover{color:#fff}
  .site-foot .navcol a{display:block; margin-bottom:6px}
  .site-foot .cr{border-top:1px solid rgba(255,255,255,.12); margin-top:26px; padding-top:16px; font-size:12.5px; color:#8fa2b6}
</style>
</head>
<body>

<Header />

<!-- BƯỚC 1 + 2: HEADLINE + SUB-HEADLINE (HERO) -->
<div class="hero">
  <div class="wrap">
    <div>
      <p class="eyebrow">{heroEyebrow}</p>
      <h1>{heroH1}</h1>
      <p class="lead">{heroLead}</p>
      <ul class="ticks">
        {heroTicks.map((t) => (<li>{t}</li>))}
      </ul>
      <div class="hero-cta">
        <a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a>
        <a class="ghost" href="#bang-gia">{heroBtnGia}</a>
      </div>
    </div>
    <div>
      {heroVideoUrl ? (
        <div class="hero-video">
          <iframe src={heroVideoUrl} title="Video giới thiệu Vận tải Lê Chung" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      ) : (
        <img class="hero-photo" src={heroAnh} alt="Đội hình xe tải chuyên nghiệp của Vận tải Lê Chung" width="640" height="480" />
      )}
    </div>
  </div>
</div>

<!-- Dải cam bằng chứng nhanh -->
<div class="badges">
  <div class="wrap">
    <span>Hơn 100 xe tải sẵn sàng</span>
    <span>Có mặt sau 30 phút nội thành</span>
    <span>Hóa đơn VAT đầy đủ</span>
    <span>Phục vụ 24/7</span>
  </div>
</div>

<!-- BƯỚC 3: NỖI ĐAU -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Bạn có đang gặp?</span>
      <h2 class="sec-title">Gửi hàng cho xe ngoài — những nỗi lo quen thuộc</h2>
      <p style="color:var(--text-soft); margin:0">Đây là những rắc rối mà chủ hàng và doanh nghiệp gặp nhiều nhất khi chọn nhầm đơn vị vận chuyển.</p>
    </div>
    <div class="grid4">
      {noiDau.map((n) => (
        <div class="pain">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg></div>
          <h3>{n.t}</h3>
          <p>{n.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 4: UY TÍN NGƯỜI BÁN -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Vì sao tin Lê Chung</span>
      <h2 class="sec-title">Một đơn vị vận tải có pháp nhân, có trách nhiệm</h2>
      <p style="color:var(--text-soft); margin:0">Hơn 10 năm trong nghề, Lê Chung làm vận tải bằng xe của mình và cam kết bằng giấy tờ rõ ràng — không phải nhà xe trôi nổi.</p>
    </div>
    <div class="adv-grid">
      {uyTin.map((u) => (
        <div class="adv">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><h3>{u.t}</h3><p>{u.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 5: BEFORE – AFTER -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Trước & Sau</span>
      <h2 class="sec-title">Khác biệt khi có Lê Chung đồng hành</h2>
    </div>
    <div class="ba">
      <div class="col before">
        <h3>Trước — tự lo với xe ngoài</h3>
        <ul>{truoc.map((t) => (<li>{t}</li>))}</ul>
      </div>
      <div class="col after">
        <h3>Sau — đi cùng Lê Chung</h3>
        <ul>{sau.map((t) => (<li>{t}</li>))}</ul>
      </div>
    </div>
  </div>
</section>

<!-- BƯỚC 6: LỢI ÍCH -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Lợi ích cho bạn</span>
      <h2 class="sec-title">Không chỉ là chiếc xe — là sự an tâm</h2>
      <p style="color:var(--text-soft); margin:0">Mỗi thế mạnh của Lê Chung đều quy về một điều bạn nhận được.</p>
    </div>
    <div class="adv-grid">
      {loiIch.map((u) => (
        <div class="adv">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><h3>{u.t}</h3><p>{u.d}</p></div>
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:28px"><a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a></div>
  </div>
</section>

<!-- BƯỚC 6 (tiếp): DỊCH VỤ / ĐỘI XE -->
<section id="dich-vu">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">{dichVuTag}</span>
      <h2 class="sec-title">{dichVuTitle}</h2>
      <p style="color:var(--text-soft); margin:0">{dichVuIntro}</p>
    </div>
    <div class="svc-grid">
      {dichVu.map((d) => (
        <div class="svc">
          <img src={d.img} alt={d.ten} width="360" height="225" loading="lazy">
          <div class="body">
            <h3>{d.ten}</h3>
            <ul>{d.bullets.map((b) => (<li>{b}</li>))}</ul>
            <div class="foot">
              <a class="more" href={`tel:${TEL}`}>Nhận báo giá →</a>
              <a class="readmore" href={matchPost(d.key)}>Xem thêm ↗</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Khu vực phục vụ -->
<section id="khu-vuc" class="area">
  <div class="wrap center" style="color:#fff; margin-bottom:0">
    <span class="step-tag" style="background:rgba(255,255,255,.12); color:#ffd9c9">Khu vực phục vụ</span>
    <h2 class="sec-title" style="color:#fff">Đâu cần Lê Chung có, đâu khó có Lê Chung</h2>
    <p style="color:#c7d3e2; margin:0">Nhận vận chuyển hai chiều từ TP.HCM đi khắp 63 tỉnh thành. Bấm vào khu vực để xem kinh nghiệm gửi hàng tuyến đó.</p>
    <div class="chips">{khuVuc.map((k) => (<a href={areaHref(k)}>{k.ten}</a>))}</div>
  </div>
</section>

<!-- BƯỚC 7: TẠO CẢM XÚC -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="emotion">
      <p>Một chuyến hàng tới trễ hay hư hỏng có thể khiến bạn mất một khách hàng đã gây dựng nhiều năm.</p>
      <div class="small">Chọn đơn vị vận tải có trách nhiệm chính là bảo vệ uy tín của bạn.</div>
    </div>
  </div>
</section>

<!-- BƯỚC 8: RÕ RÀNG – QUY TRÌNH -->
<section id="quy-trinh">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Quy trình 4 bước</span>
      <h2 class="sec-title">Đặt xe nhanh gọn, không rườm rà</h2>
    </div>
    <div class="steps">
      {quyTrinh.map((q) => (
        <div class="step">
          <div class="n">{q.s}</div>
          <h3>{q.t}</h3>
          <p>{q.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 9: GIÁ TRỊ LỚN -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Giá trị bạn nhận được</span>
      <h2 class="sec-title">Thuê Lê Chung là mua sự yên tâm</h2>
    </div>
    <div class="grid4">
      {giaTriLon.map((g) => (
        <div class="pain">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <h3>{g.t}</h3>
          <p>{g.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 10: XỬ LÝ TỪ CHỐI -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Còn băn khoăn?</span>
      <h2 class="sec-title">Chúng tôi trả lời thẳng</h2>
    </div>
    <div class="faq">
      {objections.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="ans">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 11: LÝ DO MUA (SỨ MỆNH) -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Lý do chọn chúng tôi</span>
      <h2 class="sec-title">Lê Chung theo đuổi cách làm vận tải tử tế</h2>
      <p style="color:var(--text-soft); margin:0">Không hoa mỹ. Chỉ ba điều, làm cho bằng được trên mọi chuyến hàng.</p>
    </div>
    <div class="pillars">
      {truCot.map((p) => (
        <div class="pillar">
          <p class="big">{p.t}</p>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 12: TẠO GIỚI HẠN -->
<section>
  <div class="wrap">
    <div class="scarcity">
      <div class="ic">!</div>
      <div>
        <h3>Đặt xe đi tỉnh trước 1–2 ngày để giữ đúng chuyến</h3>
        <p>Lịch xe đi tỉnh chạy theo khung ngày cố định và thường kín chỗ vào cao điểm, cuối tuần và dịp lễ Tết. Đặt sớm để chắc chắn có xe đúng ngày bạn cần. Khách đi định kỳ hoặc ký hợp đồng dài hạn được ưu tiên xe và mức cước tốt hơn.</p>
      </div>
    </div>
  </div>
</section>

<!-- BƯỚC 13: GIÁ TRỊ THẬT + BẢNG GIÁ -->
<section id="bang-gia" style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Bảng giá cước tham khảo</span>
      <h2 class="sec-title">Giá thuê xe tải chở hàng đi tỉnh</h2>
    </div>
    <p class="value-line">Cước một chuyến xe luôn <b>rẻ hơn nhiều</b> so với cái giá của một lô hàng tới trễ hay hư hỏng. Dưới đây là mức tham khảo để bạn dự trù chi phí — thuê <b>nguyên chuyến</b> từ TP.HCM đi các tỉnh, đơn vị: <b>triệu đồng / chuyến</b>.</p>
    <p class="swipe-hint">← vuốt ngang để xem đủ bảng →</p>
    <div class="price-wrap">
      <table class="price">
        <thead>
          <tr>
            <th>Tuyến (TP.HCM đi)</th>
            <th>Xe 8 tấn</th>
            <th>Xe 10 tấn</th>
            <th>Xe 15 tấn</th>
            <th>Xe 20 tấn</th>
            <th>Thời gian</th>
          </tr>
        </thead>
        <tbody>
          {bangGia.map((r) => (
            <tr>
              <td>{r.vung}</td>
              <td class="money">{r.t8}</td>
              <td class="money">{r.t10}</td>
              <td class="money">{r.t15}</td>
              <td class="money">{r.t20}</td>
              <td class="tg">{r.tg}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="price-note">
      <b>Lưu ý:</b> Giá trên là mức tham khảo cho chuyến nguyên xe, <b>chưa gồm VAT 8%</b>, phí bốc xếp tận nơi và phí đường cấm (nếu có).
      Giá thực tế thay đổi theo loại hàng, thời điểm và tuyến cụ thể. <b>Xe cẩu và container 30 tấn</b> báo giá riêng.
      Gọi <a href={`tel:${TEL}`} class="tnum" style="color:var(--brand-dark);font-weight:800;text-decoration:none">{HOTLINE}</a> để nhận báo giá chính xác trong 30 phút.
    </p>
    <div class="price-cta"><a class="btn-call" href={`tel:${TEL}`}>📞 Nhận báo giá chính xác</a></div>
  </div>
</section>

<!-- BƯỚC 14: QUÀ TẶNG / CAM KẾT THÊM -->
<section>
  <div class="wrap">
    <div class="bonus">
      <span class="step-tag" style="background:rgba(255,255,255,.12); color:#ffd9c9">Khi chọn Lê Chung, bạn được thêm</span>
      <h2 class="sec-title">Quà tặng đi kèm mọi chuyến hàng</h2>
      <ul>{quaTang.map((q) => (<li>{q}</li>))}</ul>
    </div>
  </div>
</section>

<!-- BƯỚC 15: TESTIMONIAL -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Khách hàng nói gì</span>
      <h2 class="sec-title">Đối tác tin tưởng</h2>
    </div>
    <div class="rev-grid">
      {danhGia.map((r) => (
        <div class="rev">
          <div class="stars">★★★★★</div>
          <p>“{r.noi}”</p>
          <div class="who">
            <img src={r.avatar} alt={r.ten} width="46" height="46" loading="lazy">
            <div><b>{r.ten}</b><br><small>{r.chuc}</small></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Blog / kinh nghiệm -->
{teaserPosts.length > 0 && (
<section id="kinh-nghiem">
  <div class="wrap">
    <div class="center">
      <span class="step-tag">Kinh nghiệm vận chuyển</span>
      <h2 class="sec-title">Đọc trước khi thuê xe cho chắc</h2>
    </div>
    <div class="blog-grid">
      {teaserPosts.map((p) => (
        <div class="bcard">
          <p class="tag">Bài viết</p>
          <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
          <p>{p.data.description}</p>
          <a class="more" href={`/blog/${p.id}`}>Đọc tiếp →</a>
        </div>
      ))}
    </div>
    <div class="blog-all"><a href="/blog">Xem tất cả bài viết →</a></div>
  </div>
</section>
)}

<!-- BƯỚC 16: CTA CUỐI -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="final">
      <h2>Sẵn sàng cho chuyến hàng an toàn, đúng hẹn?</h2>
      <p>Gọi Lê Chung để nhận khảo sát và báo giá miễn phí trong 30 phút. Đội xe hơn 100 chiếc luôn sẵn sàng.</p>
      <a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="site-foot">
  <div class="wrap">
    <div class="cols">
      <div style="max-width:360px">
        <b class="brand">CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG</b>
        Địa chỉ: 77 Đường số 2A, Phường Bình Tân, TP. Hồ Chí Minh<br>
        Hotline: <a href={`tel:${TEL}`} class="tnum">{HOTLINE}</a><br>
        Mã số thuế: <span class="tnum">0314664033</span>
      </div>
      <div class="navcol">
        <b class="brand" style="font-size:14px">Liên kết</b>
        <a href="/">Trang chủ</a>
        <a href="#dich-vu">Dịch vụ</a>
        <a href="#bang-gia">Bảng giá</a>
        <a href="#khu-vuc">Khu vực</a>
        <a href="#quy-trinh">Quy trình</a>
        <a href="/blog">Blog kinh nghiệm</a>
      </div>
    </div>
    <div class="cr">© 2026 CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG. Vận tải tử tế — đúng giờ, đúng giá, có trách nhiệm.</div>
  </div>
</footer>


</body>
</html>
