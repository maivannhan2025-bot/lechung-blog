---
// Trang chủ Vận tải Lê Chung — dựng lại từ web hiện tại (bỏ FunnelTex).
// Trang tự chứa (không dùng Layout mặc định), cùng tông màu với blog.
import { getCollection } from 'astro:content';

const HOTLINE = '0839 861 499';
const TEL = '0839861499';

// Blog: nạp tất cả bài, mới nhất trước — dùng cho menu "Blog", mục "Xem thêm" và khối kinh nghiệm.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf()
);
const norm = (s) => (s || '').toLowerCase();
// Tự nối mỗi mục dịch vụ với bài blog phù hợp nhất (theo từ khoá); không có thì lấy bài mới nhất, không có bài nào thì về trang /blog.
function matchPost(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return '/blog/' + hit.id;
  }
  return posts.length ? '/blog/' + posts[0].id : '/blog';
}
// Tìm id bài theo từ khoá (chặt — không có thì trả null); dùng cho menu Khu vực.
function findId(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return hit.id;
  }
  return null;
}
// Link cho từng khu vực: ưu tiên bài đúng vùng (theo slug), rồi bài có từ khoá, cuối cùng về mục Khu vực.
function areaHref(a) {
  if (posts.find((p) => p.id === a.slug)) return '/blog/' + a.slug;
  const id = findId(a.kw);
  return id ? '/blog/' + id : '#khu-vuc';
}
const menuPosts = posts.slice(0, 4); // hiện trong menu xổ "Blog"
const teaserPosts = posts.slice(0, 3); // hiện ở khối "Kinh nghiệm vận chuyển"

