---
// Trang chủ Vận tải Lê Chung — bố cục kiểu Vận Tải Danh Long (anh Nhận chốt), giữ màu cam+navy
// và toàn bộ nội dung/số liệu thật của Lê Chung (KHÔNG bịa số liệu/lời khách).
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import trangchu from '../data/trangchu.json';
import chung from '../data/chung.json';

const HOTLINE = chung.hotline;
const TEL = chung.tel;

// ==== Cấu hình lấy từ /quan-ly (Cài đặt + Liên hệ) — để MỌI ô đều dùng thật ====
const _c = chung as { gscVerify?: string; bingVerify?: string; companyFull?: string; mst?: string; address?: string; zalo?: string; messenger?: string; fbPixel?: string; fbPixelId?: string; gaId?: string; contactForm?: string; contactFormTitle?: string; contactFormDelay?: string | number; favicon?: string };
// SEO: xác minh Google/Bing (nhận cả thẻ <meta ... content="..."> lẫn dãy mã trần)
const _gscRaw = _c.gscVerify || '';
const gscVerify = (_gscRaw.match(/content=["']([^"']+)["']/i)?.[1] || _gscRaw.replace(/<[^>]*>/g, '')).trim();
const _bingRaw = _c.bingVerify || '';
const bingVerify = (_bingRaw.match(/content=["']([^"']+)["']/i)?.[1] || _bingRaw.replace(/<[^>]*>/g, '')).trim();
// Liên hệ mở rộng (footer + Schema đọc từ đây; sửa ở /quan-ly > Liên hệ)
const COMPANY_FULL = _c.companyFull || 'CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG';
const MST = _c.mst || '0314664033';
const ADDRESS = _c.address || '77 Đường số 2A, Phường Bình Tân, TP. Hồ Chí Minh';
const mapEmbed = 'https://www.google.com/maps?q=' + encodeURIComponent(ADDRESS) + '&output=embed';
// Quảng cáo / đo lường / form (sửa ở /quan-ly > Cài đặt)
const FB_PIXEL = (_c.fbPixelId || _c.fbPixel || '').trim();
const GA_ID = ((_c.gaId || '').match(/\b(G-[A-Z0-9]+|UA-[0-9-]+|GTM-[A-Z0-9]+)\b/i)?.[0] || '').trim();
const CONTACT_FORM = _c.contactForm || '';
const CONTACT_FORM_TITLE = _c.contactFormTitle || 'Nhận tư vấn & báo giá';
const CONTACT_FORM_DELAY = Number(_c.contactFormDelay) || 6;
// Favicon (icon nhỏ ở tab trình duyệt, sửa ở /quan-ly > Liên hệ) — để trống thì giữ y như cũ (favicon.svg + favicon.ico mặc định)
const FAVICON = (_c.favicon || '').trim();
const FAVICON_TYPE: Record<string, string> = { svg: 'image/svg+xml', png: 'image/png', webp: 'image/webp', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };
const FAVICON_MIME = FAVICON_TYPE[FAVICON.split('.').pop()?.toLowerCase() || ''] || 'image/png';
// Schema doanh nghiệp
const _logoAbs = 'https://lechung.vn' + (chung.logo || '/favicon.svg');
const bizSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: COMPANY_FULL,
  url: 'https://lechung.vn/',
  telephone: (TEL || '').replace(/^0/, '+84'),
  image: _logoAbs,
  logo: _logoAbs,
  address: { '@type': 'PostalAddress', streetAddress: ADDRESS, addressLocality: 'TP. Hồ Chí Minh', addressCountry: 'VN' },
  areaServed: 'TP. Hồ Chí Minh và các tỉnh thành',
  ...(MST ? { vatID: MST } : {}),
};

// Ảnh/video đầu trang — anh Nhận tự đổi ở /quan-ly (mục "Sửa trang chủ"). Có link YouTube => hiện VIDEO; trống => hiện ẢNH.
function youtubeEmbed(url){
  if(!url) return '';
  const u = String(url).trim();
  let m;
  const id =
    (m = u.match(/[?&]v=([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/youtu\.be\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/embed\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/shorts\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/^([A-Za-z0-9_-]{11})$/)) ? m[1] : '';
  return id ? 'https://www.youtube-nocookie.com/embed/' + id : '';
}
const heroVideoUrl = youtubeEmbed(trangchu && trangchu.heroVideo);
const heroAnh = (trangchu && trangchu.heroAnh) || '/img/doi-xe.webp';
const heroSlides = (trangchu && trangchu.heroSlides && trangchu.heroSlides.length) ? trangchu.heroSlides : [heroAnh];
const ogImage = /^https?:\/\//.test(heroAnh) ? heroAnh : ('https://lechung.vn' + heroAnh);
const heroEyebrow = trangchu.heroEyebrow;
const heroH1 = trangchu.heroH1;
const heroLead = trangchu.heroLead;
const heroTicks = trangchu.heroTicks || [];
const heroBtnGia = trangchu.heroBtnGia;
const dichVuTag = trangchu.dichVuTag;
const dichVuTitle = trangchu.dichVuTitle;
const dichVuIntro = trangchu.dichVuIntro;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.ngayDang.valueOf() <= Date.now())
  .sort((a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf());
const teaserPosts = posts.slice(0, 6);
// Ảnh đại diện bài blog: ưu tiên ảnh anh Nhận đặt riêng (anhDaiDien), chưa có thì xoay vòng ảnh xe (giống trang /blog)
const ANH_MAC_DINH_BAI = ['/anh/xe-8-tan.webp', '/anh/xe-10-tan.webp', '/anh/xe-15-tan.webp', '/anh/xe-cau.webp', '/anh/xe-container.webp', '/anh/xe-20-tan.webp', '/img/doi-xe.webp'];
const anhBai = (bai, i) => bai.data.anhDaiDien || ANH_MAC_DINH_BAI[i % ANH_MAC_DINH_BAI.length];
const norm = (s) => (s || '').toLowerCase();
function matchPost(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return '/blog/' + hit.id;
  }
  return posts.length ? '/blog/' + posts[0].id : '/blog';
}
function findId(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return hit.id;
  }
  return null;
}
function areaHref(a) {
  if (posts.find((p) => p.id === a.slug)) return '/blog/' + a.slug;
  const id = findId(a.kw);
  return id ? '/blog/' + id : '#khu-vuc';
}

const uyTin = trangchu.uyTin || [];
const loiIch = trangchu.loiIch || [];

const dichVuKeys = [
  ['8 tấn','tải trọng','loại xe'],
  ['10 tấn','tải trọng','loại xe'],
  ['15 tấn','nguyên chuyến','đi tỉnh'],
  ['20 tấn','container','nguyên chuyến'],
  ['cẩu','bốc xếp','nâng hạ'],
  ['container','đầu kéo','cảng','nguyên chuyến'],
];
const dichVu = (trangchu.dichVu || []).map((d, i) => ({ ...d, key: dichVuKeys[i] || [] }));

const khuVuc = [
  { ten: 'TP. Hồ Chí Minh', slug: 'van-chuyen-hang-hoa-noi-thanh-tphcm', kw: ['nội thành', 'tphcm', 'hồ chí minh', 'sài gòn'] },
  { ten: 'Miền Đông Nam Bộ', slug: 'van-chuyen-hang-di-mien-dong-nam-bo', kw: ['miền đông', 'đồng nai', 'bình dương', 'vũng tàu'] },
  { ten: 'Miền Tây Nam Bộ', slug: 'van-chuyen-hang-di-mien-tay', kw: ['miền tây', 'cần thơ', 'long an', 'tiền giang'] },
  { ten: 'Tây Nguyên', slug: 'van-chuyen-hang-di-tay-nguyen', kw: ['tây nguyên', 'đắk lắk', 'gia lai', 'lâm đồng', 'pleiku'] },
  { ten: 'Miền Trung', slug: 'van-chuyen-hang-di-mien-trung', kw: ['miền trung', 'đà nẵng', 'huế', 'quy nhơn', 'nha trang'] },
  { ten: 'Miền Bắc', slug: 'van-chuyen-hang-di-mien-bac', kw: ['miền bắc', 'hà nội', 'hải phòng'] },
];

const quyTrinh = trangchu.quyTrinh || [];
const objections = trangchu.objections || [];
const bangGia = trangchu.bangGia || [];
const danhGia = trangchu.danhGia || [];
const badges = trangchu.badges || [];
const secUyTin = trangchu.secUyTin || {};
const secLoiIch = trangchu.secLoiIch || {};
const secKhuVuc = trangchu.secKhuVuc || {};
const camXuc = trangchu.camXuc || {};
const secQuyTrinh = trangchu.secQuyTrinh || {};
const secObjections = trangchu.secObjections || {};
const secBangGia = trangchu.secBangGia || {};
const secDanhGia = trangchu.secDanhGia || {};
const secBlog = trangchu.secBlog || {};
const ctaCuoi = trangchu.ctaCuoi || {};

// Icon xe dùng lại cho vài chỗ (dòng kẻ tiêu đề mục kiểu Danh Long)
const ICON_TRUCK_LINE = '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h11V6H3zM16 9h3l3 3v3h-6zM6.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>';
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{FAVICON ? <link rel="icon" type={FAVICON_MIME} href={FAVICON} /> : <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /></>}
<title>Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung {HOTLINE}</title>
<meta name="description" content={`Thuê xe tải chở hàng TP.HCM đi toàn quốc — Vận Tải Lê Chung: đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Báo giá miễn phí ${HOTLINE}.`}>
<link rel="canonical" href="https://lechung.vn/">
<meta property="og:title" content="Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung">
<meta property="og:description" content={`Đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Hotline ${HOTLINE}.`}>
<meta property="og:type" content="website">
<meta property="og:url" content="https://lechung.vn/">
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Vận Tải Lê Chung">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung">
<meta name="twitter:description" content={`Đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Hotline ${HOTLINE}.`}>
<meta name="twitter:image" content={ogImage}>
{gscVerify && <meta name="google-site-verification" content={gscVerify} />}
{bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script type="application/ld+json" is:inline set:html={JSON.stringify(bizSchema)} />
{/* Facebook Pixel (chỉ chạy khi có mã ở /quan-ly > Cài đặt) */}
{FB_PIXEL && (<script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${FB_PIXEL}');fbq('track','PageView');`} />)}
{FB_PIXEL && (<noscript set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${FB_PIXEL}&ev=PageView&noscript=1"/>`} />)}
{/* Google Analytics 4 (chỉ chạy khi có mã G-XXXX hợp lệ) */}
{GA_ID && <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />}
{GA_ID && (<script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${GA_ID}');`} />)}
<style is:global>
  :root{
    --bg:#fffaf6; --panel:#fff3ea; --panel-2:#ffe7d8; --card:#ffffff; --line:#f0ddd0;
    --text:#1a1410; --text-soft:#4a3f37; --muted:#7a6c62;
    --brand:#ff6b35; --brand-dark:#c73d10; --brand-light:#ff9466; --brand-tint:#ffe7d8;
    --navy:#070d14; --navy-2:#0e1c2c; --navy-3:#18293c; --ink:#050a10; --gold:#f0b23e;
    --danger:#d0483a;
    --shadow-sm:0 1px 2px rgba(20,12,6,.05), 0 3px 10px rgba(20,12,6,.05);
    --shadow:0 4px 16px rgba(20,12,6,.07), 0 16px 44px rgba(20,12,6,.10);
    --shadow-lg:0 24px 64px rgba(7,13,20,.28);
    --radius:14px; --radius-lg:22px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Manrope','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif; line-height:1.65; -webkit-font-smoothing:antialiased; overflow-x:hidden}
  .wrap{max-width:1160px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  img{max-width:100%; display:block}
  .tnum{font-variant-numeric:tabular-nums}
  .step-tag{display:inline-block; color:var(--brand-dark); background:var(--brand-tint); font-weight:800; font-size:12px; letter-spacing:.05em; padding:5px 12px; border-radius:999px; margin:0 0 12px}
  .sec-title{font-size:clamp(24px,3.6vw,36px); font-weight:900; letter-spacing:-.02em; margin:0 0 14px; line-height:1.18; color:var(--ink)}
  .btn-call{display:inline-flex; align-items:center; gap:9px; background:linear-gradient(160deg,var(--brand),var(--brand-dark)); color:#fff; text-decoration:none; font-weight:800; font-size:16px; padding:14px 28px; border-radius:12px; box-shadow:0 10px 26px rgba(199,61,16,.35); border:0; cursor:pointer; transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease, filter .2s ease}
  .btn-call:hover{filter:brightness(1.06); transform:translateY(-2px); box-shadow:0 16px 34px rgba(199,61,16,.42)}
  .btn-ghost{display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,.08); border:1.5px solid rgba(255,255,255,.55); color:#fff; text-decoration:none; font-weight:800; font-size:15px; padding:13px 24px; border-radius:12px; backdrop-filter:blur(4px); transition:background .2s ease, transform .2s ease}
  .btn-ghost:hover{background:rgba(255,255,255,.18); transform:translateY(-2px)}
  .btn-line{display:inline-flex; align-items:center; gap:8px; color:var(--ink); text-decoration:none; font-weight:800; font-size:15px; padding:13px 24px; border-radius:12px; border:1.5px solid rgba(26,20,16,.2); transition:background .2s ease, transform .2s ease}
  .btn-line:hover{background:rgba(26,20,16,.05); transform:translateY(-2px)}

  section{padding:70px 0}
  .alt{background:var(--panel)}
  .center{text-align:center; max-width:700px; margin:0 auto 36px}

  /* dòng kẻ + icon xe dưới mỗi tiêu đề mục — chữ ký của bố cục Danh Long */
  .tl-line{display:flex; align-items:center; justify-content:center; gap:10px; color:var(--brand-dark); margin-top:4px}
  .tl-line::before,.tl-line::after{content:''; height:2px; width:60px; background:linear-gradient(90deg,transparent,var(--brand-dark))}
  .tl-line::after{background:linear-gradient(90deg,var(--brand-dark),transparent)}
  .tl-line svg{animation:drive 3.2s ease-in-out infinite}
  @keyframes drive{0%,100%{transform:translateX(-3px)} 50%{transform:translateX(3px)}}

  /* QUICKBAR — dải icon dưới hero, kiểu Danh Long */
  .quickbar{background:var(--navy); color:#fff; position:relative; z-index:2}
  .qb-in{display:grid; grid-template-columns:repeat(4,1fr)}
  .qb-item{display:flex; align-items:center; gap:12px; padding:20px 18px; border-left:1px solid rgba(255,255,255,.08)}
  .qb-item:first-child{border-left:0}
  .qb-ic{width:40px;height:40px;border-radius:11px;background:rgba(255,107,53,.16);color:var(--brand-light);display:grid;place-items:center;flex:0 0 auto}
  .qb-item b{display:block;font-size:14.5px;font-weight:800}
  @media(max-width:900px){ .qb-in{grid-template-columns:repeat(2,1fr)} .qb-item:nth-child(3){border-left:0} }
  @media(max-width:560px){ .qb-in{grid-template-columns:1fr} .qb-item{border-left:0 !important;border-top:1px solid rgba(255,255,255,.08)} .qb-item:first-child{border-top:0} }

  /* HERO + GIỚI THIỆU — GOM 1 khối 2 cột: chữ trái, ảnh/video phải (kiểu Danh Long) */
  .intro-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center}
  @media(max-width:880px){ .intro-grid{grid-template-columns:1fr; gap:34px} }
  .intro-txt h1{font-size:clamp(26px,4.2vw,42px); font-weight:900; letter-spacing:-.02em; margin:0 0 14px; line-height:1.16; text-wrap:balance}
  .intro-txt p{color:var(--text-soft); font-size:15.5px; margin:0 0 12px}
  .commit{list-style:none; margin:18px 0 24px; padding:0; display:grid; gap:10px}
  .commit li{position:relative; padding-left:30px; font-weight:700; font-size:14.5px}
  .commit li::before{content:'✓'; position:absolute; left:0; top:1px; width:20px;height:20px; background:var(--brand); color:#fff; border-radius:50%; display:grid; place-items:center; font-size:11px; font-weight:900}
  .intro-btns{display:flex; gap:12px; flex-wrap:wrap}
  .btn-dark{background:linear-gradient(160deg,var(--navy-3),var(--navy)); color:#fff; box-shadow:0 12px 26px rgba(7,13,20,.32)}
  /* khung ảnh/video: LUÔN đúng tỉ lệ 16:9 để gắn video YouTube gọn gàng như Danh Long, đổi ảnh vẫn vừa khung */
  .intro-media{position:relative}
  .intro-slides,.intro-video{position:relative; width:100%; aspect-ratio:16/9; border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg); background:var(--navy)}
  .intro-slides .slide{position:absolute; inset:0; opacity:0; transition:opacity 1.4s ease}
  .intro-slides .slide.active{opacity:1}
  .intro-slides .slide img{width:100%; height:100%; object-fit:cover; display:block}
  .intro-video iframe{position:absolute; inset:0; width:100%; height:100%; border:0}
  @media(max-width:520px){ .intro-slides,.intro-video{aspect-ratio:4/3} }
  .intro-badge{position:absolute; left:-16px; bottom:-18px; background:var(--navy); color:#fff; border-radius:14px; padding:14px 18px; box-shadow:var(--shadow-lg); display:flex; align-items:center; gap:10px; border:1px solid rgba(255,255,255,.08)}
  .intro-badge svg{color:var(--brand-light); flex:0 0 auto}
  .intro-badge span{font-size:12.5px; font-weight:800; line-height:1.25}
  @media(max-width:880px){ .intro-badge{left:50%; transform:translateX(-50%)} }

  /* dịch vụ — card icon tròn */
  .cards{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){ .cards{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:600px){ .cards{grid-template-columns:1fr} }
  .card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:transform .3s ease, box-shadow .3s ease}
  .card:hover{transform:translateY(-5px); box-shadow:var(--shadow)}
  .card-img{width:100%; aspect-ratio:16/10; object-fit:cover}
  .card-body{padding:20px 22px 22px; display:flex; flex-direction:column; flex:1}
  .card h3{margin:0 0 10px; font-size:17px; font-weight:800}
  .card ul{margin:0 0 16px; padding:0; list-style:none; flex:1}
  .card li{position:relative; padding-left:22px; margin-bottom:7px; font-size:14px; color:var(--text-soft)}
  .card li::before{content:'✓'; position:absolute; left:0; color:var(--brand-dark); font-weight:900}
  .card .foot{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .card a.more{display:inline-flex; gap:7px; align-items:center; background:var(--brand-tint); color:var(--brand-dark); text-decoration:none; font-weight:800; font-size:13.5px; padding:9px 14px; border-radius:9px; transition:background .2s ease, color .2s ease}
  .card a.more:hover{background:var(--brand); color:#fff}
  .card a.readmore{color:var(--brand-dark); font-weight:800; font-size:13px; text-decoration:none}
  .card a.readmore:hover{text-decoration:underline}

  /* stats */
  .stats-strip{background:var(--card); border-top:1px solid var(--line); border-bottom:1px solid var(--line)}
  .stats-in{display:grid; grid-template-columns:repeat(4,1fr)}
  .stat{text-align:center; padding:34px 10px; position:relative}
  .stat::before{content:''; position:absolute; left:0; top:14px; bottom:14px; width:1px; background:var(--line)}
  .stat:first-child::before{display:none}
  .stat svg{color:var(--brand-dark); margin-bottom:8px}
  .stat b{display:block; font-size:clamp(24px,3.4vw,34px); font-weight:900; letter-spacing:-.01em; color:var(--ink)}
  .stat span{display:block; font-size:13px; color:var(--muted); font-weight:700; margin-top:4px}
  @media(max-width:760px){ .stats-in{grid-template-columns:repeat(2,1fr)} .stat:nth-child(3)::before{display:none} }

  /* vì sao chọn / lợi ích */
  .adv-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:18px}
  @media(max-width:640px){ .adv-grid{grid-template-columns:1fr} }
  .adv{display:flex; gap:16px; align-items:flex-start; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:20px 22px; box-shadow:var(--shadow-sm); transition:box-shadow .3s ease, transform .3s ease}
  .adv:hover{box-shadow:var(--shadow); transform:translateY(-3px)}
  .adv .ic{flex:0 0 auto; width:46px;height:46px;border-radius:12px;background:linear-gradient(160deg,var(--navy-3),var(--navy));color:#fff;display:grid;place-items:center; box-shadow:0 6px 16px rgba(5,8,12,.28)}
  .adv h3{margin:0 0 6px; font-size:16px; font-weight:800}
  .adv p{margin:0; color:var(--text-soft); font-size:14px}

  /* cta giữa trang */
  .cta-mid{background:linear-gradient(155deg,var(--navy),var(--navy-2)); color:#fff; border-radius:var(--radius-lg); padding:44px 40px; display:flex; justify-content:space-between; align-items:center; gap:30px; flex-wrap:wrap; box-shadow:var(--shadow-lg)}
  .cta-mid h2{margin:0 0 8px; font-size:clamp(20px,2.6vw,27px); font-weight:900}
  .cta-mid p{margin:0; color:#c3d0dc; max-width:520px; font-size:15px}

  /* quy trình */
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:18px}
  @media(max-width:860px){ .steps{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:480px){ .steps{grid-template-columns:1fr} }
  .step{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); position:relative; overflow:hidden; transition:box-shadow .3s ease, transform .3s ease}
  .step:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .step-no{position:absolute; right:14px; top:8px; font-size:38px; font-weight:900; color:var(--line)}
  .step .n{width:46px;height:46px;border-radius:13px;background:linear-gradient(160deg,var(--brand),var(--brand-dark));color:#fff;font-weight:900;display:grid;place-items:center;font-size:17px;margin-bottom:14px; box-shadow:0 8px 18px rgba(199,61,16,.32); position:relative}
  .step h3{margin:0 0 6px; font-size:16px; font-weight:800; position:relative}
  .step p{margin:0; color:var(--text-soft); font-size:13.6px; position:relative}

  /* đội xe — lưới ảnh đơn giản */
  /* kinh nghiệm / blog — 6 ô 2 hàng */
  .blog-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){ .blog-grid{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:600px){ .blog-grid{grid-template-columns:1fr} }
  .bcard{background:var(--card); border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .3s ease, box-shadow .3s ease}
  .bcard:hover{transform:translateY(-4px); box-shadow:var(--shadow)}
  .bcard-img{width:100%; aspect-ratio:16/10; object-fit:cover}
  .bcard-body{padding:20px 22px 22px; display:flex; flex-direction:column; flex:1}
  .bcard h3{margin:0 0 8px; font-size:16px; font-weight:800; color:var(--ink); line-height:1.35}
  .bcard p{margin:0 0 14px; color:var(--text-soft); font-size:13.5px; flex:1}
  .bcard .more{color:var(--brand-dark); font-weight:800; font-size:13.5px}
  .blog-all{text-align:center; margin-top:26px}
  .blog-all a{display:inline-flex; align-items:center; gap:8px; color:var(--brand-dark); font-weight:800; text-decoration:none; border:1.5px solid var(--brand); padding:11px 22px; border-radius:11px; transition:background .2s ease, color .2s ease}
  .blog-all a:hover{background:var(--brand); color:#fff}

  /* bảng giá */
  .value-line{text-align:center; max-width:760px; margin:0 auto 28px; font-size:16px; color:var(--text-soft)}
  .value-line b{color:var(--ink)}
  .price-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow); background:var(--card)}
  table.price{width:100%; border-collapse:collapse; min-width:640px; font-size:14px}
  table.price thead th{background:linear-gradient(160deg,var(--navy-3),var(--navy)); color:#fff; font-weight:800; padding:15px 16px; text-align:center; font-size:13.5px}
  table.price thead th:first-child{text-align:left; border-top-left-radius:var(--radius-lg)}
  table.price thead th:last-child{border-top-right-radius:var(--radius-lg)}
  table.price tbody td{padding:13px 16px; border-top:1px solid var(--line); text-align:center; color:var(--text-soft)}
  table.price tbody td:first-child{text-align:left; font-weight:700; color:var(--ink)}
  table.price tbody tr:nth-child(even){background:color-mix(in srgb, var(--brand-tint) 45%, transparent)}
  table.price tbody tr:hover{background:var(--panel)}
  table.price .money{font-weight:800; color:var(--brand-dark)}
  table.price tbody td.tg{color:var(--muted); font-size:13px}
  .price-note{margin:18px auto 0; max-width:820px; color:var(--muted); font-size:13.5px; text-align:center}
  .price-note b{color:var(--text-soft)}
  .price-cta{text-align:center; margin-top:24px}
  .swipe-hint{display:none}
  @media(max-width:560px){ table.price{min-width:520px; font-size:13px} table.price thead th{padding:12px 10px; font-size:12.5px} table.price tbody td{padding:11px 10px} .swipe-hint{display:block; text-align:center; color:var(--muted); font-size:12.5px; margin:0 0 10px} }

  /* khu vực */
  .area{background:linear-gradient(160deg,var(--navy),var(--ink)); color:#fff}
  .area .chips{display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:20px}
  .area .chips a{background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16); padding:10px 18px; border-radius:999px; font-weight:700; font-size:14.5px; color:#fff; text-decoration:none; transition:background .2s ease, border-color .2s ease, transform .2s ease}
  .area .chips a:hover{background:var(--brand); border-color:var(--brand); transform:translateY(-2px)}

  /* testimonials */
  .rev-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){ .rev-grid{grid-template-columns:1fr} }
  .rev{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:box-shadow .3s ease, transform .3s ease}
  .rev:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .rev .stars{color:var(--gold); font-size:15px; letter-spacing:2px; margin-bottom:10px}
  .rev p{margin:0 0 16px; font-size:14.5px; color:var(--text-soft); flex:1}
  .rev .who{display:flex; align-items:center; gap:12px}
  .rev .who img{width:48px;height:48px;border-radius:50%; object-fit:cover; border:2px solid var(--brand-tint)}
  .rev .who b{font-size:14.5px}
  .rev .who small{color:var(--muted); font-size:12.5px}

  /* faq */
  .faq{max-width:820px; margin:0 auto}
  .faq details{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:0; margin-bottom:12px; box-shadow:var(--shadow-sm); overflow:hidden; transition:box-shadow .25s ease}
  .faq details[open]{box-shadow:var(--shadow)}
  .faq summary{cursor:pointer; list-style:none; padding:19px 22px; font-weight:800; font-size:15.5px; color:var(--ink); display:flex; justify-content:space-between; gap:14px; align-items:center}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+'; color:var(--brand-dark); font-size:22px; font-weight:400; flex:0 0 auto}
  .faq details[open] summary::after{content:'−'}
  .faq .ans{padding:0 22px 20px; color:var(--text-soft); font-size:14.5px}

  /* cta cuối */
  .final{background:linear-gradient(155deg,var(--brand),var(--brand-dark) 70%,#7d260a); color:#fff; border-radius:var(--radius-lg); padding:48px 32px; text-align:center; box-shadow:0 30px 70px rgba(199,61,16,.32)}
  .final h2{margin:0 0 10px; font-size:clamp(24px,3.6vw,36px); font-weight:900}
  .final p{margin:0 0 24px; font-size:16px; opacity:.95}
  .final .btn-call{background:#fff; color:var(--brand-dark); box-shadow:0 12px 30px rgba(5,8,12,.25)}
  .final .btn-call:hover{background:var(--ink); color:#fff}

  /* footer 4 cột kèm bản đồ */
  .site-foot{background:linear-gradient(180deg,var(--navy),var(--ink)); color:#a7b3bd; padding:56px 0 0; font-size:14px}
  .ft-grid{display:grid; grid-template-columns:1.2fr 1fr 1fr 1.1fr; gap:32px; padding-bottom:44px}
  @media(max-width:920px){ .ft-grid{grid-template-columns:1fr 1fr} }
  @media(max-width:560px){ .ft-grid{grid-template-columns:1fr} }
  .ft-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .ft-logo img{height:40px;border-radius:8px}
  .ft-legal{font-size:13.5px; line-height:1.85}
  .ft-legal b{color:#fff}
  .ft-social{display:flex;gap:10px;margin-top:16px}
  .ft-social a{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.08);display:grid;place-items:center;color:#fff;text-decoration:none}
  .ft-social a:hover{background:var(--brand)}
  .ft-col h4{color:#fff;font-size:14px;font-weight:800;margin:0 0 14px;text-transform:uppercase;letter-spacing:.03em;opacity:.9}
  .ft-col ul{list-style:none;margin:0;padding:0}
  .ft-col li{padding:5px 0;font-size:13.5px}
  .ft-col a:hover{color:var(--brand-light)}
  .ft-contact li{display:flex;align-items:center;gap:8px}
  .ft-map{border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.12);aspect-ratio:4/3}
  .ft-map iframe{width:100%;height:100%;border:0;filter:grayscale(.25) brightness(.9)}
  .copyright{border-top:1px solid rgba(255,255,255,.08);padding:18px 0;text-align:center;font-size:12.5px;color:#6d7f92}

  /* ===== HIỆU ỨNG CUỘN-HIỆN (dùng lại đúng cơ chế reveal-on của Header.astro) ===== */
  html.reveal-on :is(
    .center,.card,.stat,.adv,.step,.bcard,.rev,.qb-item,
    .intro-txt,.intro-media,.cta-mid,.price-wrap,.value-line,.faq,.chips,.final
  ){
    opacity:0; transform:translateY(30px);
    transition:opacity 1s ease, transform 1.2s cubic-bezier(.16,.72,.28,1);
    will-change:opacity, transform;
  }
  html.reveal-on .is-in{ opacity:1 !important; transform:none !important; }
  @media(prefers-reduced-motion:reduce){ .tl-line svg{animation:none} }
</style>
</head>
<body>

<Header />

<!-- HERO + GIỚI THIỆU kiểu Danh Long: GOM 1 khối — chữ trái, ảnh/video phải đúng tỉ lệ 16:9 -->
<section id="gioi-thieu" class="hero-intro">
  <div class="wrap intro-grid">
    <div class="intro-txt">
      <span class="step-tag" data-edit="t:heroEyebrow">{heroEyebrow}</span>
      <h1 data-edit="t:heroH1">{heroH1}</h1>
      <p class="lead" data-edit="t:heroLead">{heroLead}</p>
      <p data-edit="t:secUyTin.intro"><b>{COMPANY_FULL}</b> — {secUyTin.intro}</p>
      <ul class="commit">
        {uyTin.map((u, i) => (<li data-edit={`t:uyTin.${i}.t`}>{u.t}</li>))}
      </ul>
      <div class="intro-btns">
        <a class="btn-call btn-dark" href={`https://zalo.me/${(_c.zalo || TEL).replace(/\s/g,'')}`} target="_blank" rel="noopener">💬 Tư vấn miễn phí</a>
        <a class="btn-line" href={`tel:${TEL}`}>📞 {HOTLINE}</a>
      </div>
    </div>
    <div class="intro-media">
      {heroVideoUrl ? (
        <div class="intro-video"><iframe src={heroVideoUrl} title="Video giới thiệu Vận tải Lê Chung" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
      ) : (
        <div class="intro-slides" id="heroSlides">
          {heroSlides.map((s, i) => (
            <div class={`slide${i === 0 ? ' active' : ''}`} data-slide={i}>
              <img src={s} data-edit-img={`t:heroSlides.${i}`} alt="Đội hình xe tải chuyên nghiệp của Vận tải Lê Chung" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>
      )}
      <div class="intro-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.4 8.9 8 11 4.6-2.1 8-6 8-11V5z"/></svg>
        <span>Uy tín<br>Đúng hẹn</span>
      </div>
    </div>
  </div>
</section>

{heroSlides.length > 1 && (
  <script is:inline define:vars={{ total: heroSlides.length }}>
    (function () {
      var wrap = document.getElementById('heroSlides');
      if (!wrap || total < 2) return;
      var slides = wrap.querySelectorAll('.slide');
      var i = 0;
      setInterval(function () {
        slides[i].classList.remove('active');
        i = (i + 1) % slides.length;
        slides[i].classList.add('active');
      }, 4500);
    })();
  </script>
)}

<!-- QUICKBAR -->
<div class="quickbar">
  <div class="wrap qb-in">
    {badges.map((b, i) => (
      <div class="qb-item">
        <span class="qb-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div><b data-edit={`t:badges.${i}`}>{b}</b></div>
      </div>
    ))}
  </div>
</div>

<!-- DỊCH VỤ -->
<section id="dich-vu" class="alt">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:dichVuTag">{dichVuTag}</span>
      <h2 class="sec-title" data-edit="t:dichVuTitle">{dichVuTitle}</h2>
      <p style="color:var(--text-soft); margin:0 0 12px" data-edit="t:dichVuIntro">{dichVuIntro}</p>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="cards">
      {dichVu.map((d, i) => (
        <div class="card">
          <img class="card-img" src={d.img} data-edit-img={`t:dichVu.${i}.img`} alt={d.ten} width="360" height="225" loading="lazy" />
          <div class="card-body">
            <h3 data-edit={`t:dichVu.${i}.ten`}>{d.ten}</h3>
            <ul>{d.bullets.map((b, j) => (<li data-edit={`t:dichVu.${i}.bullets.${j}`}>{b}</li>))}</ul>
            <div class="foot">
              <a class="more" href={`tel:${TEL}`}>Nhận báo giá →</a>
              <a class="readmore" href={matchPost(d.key)}>Xem thêm ↗</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SỐ LIỆU -->
<div class="stats-strip">
  <div class="wrap stats-in">
    <div class="stat"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="7" width="15" height="10" rx="1.5"/><path d="M16 10h4l3 3v4h-7z"/></svg><b data-count="100" data-suffix="+">0+</b><span>Đầu xe sở hữu riêng</span></div>
    <div class="stat"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.4 8.9 8 11 4.6-2.1 8-6 8-11V5z"/></svg><b data-count="63">0</b><span>Tỉnh thành phục vụ</span></div>
    <div class="stat"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg><b data-count="10" data-suffix="+">0+</b><span>Năm kinh nghiệm vận tải</span></div>
    <div class="stat"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c1 .3 2 .5 3 .6a2 2 0 0 1 1.7 2Z"/></svg><b>24/7</b><span>Nhận điện thoại &amp; điều xe</span></div>
  </div>
</div>

<script is:inline>
  // Số nhảy tăng dần khi cuộn tới dải số liệu — chạy 1 lần cho mỗi số
  (function () {
    var strip = document.querySelector('.stats-strip');
    if (!strip) return;
    var nums = strip.querySelectorAll('[data-count]');
    if (!nums.length) return;
    function animate(el) {
      var target = parseInt(el.getAttribute('data-count'), 10) || 0;
      var suffix = el.getAttribute('data-suffix') || '';
      var dur = 1400, start = null;
      function ease(t){ return 1 - Math.pow(1 - t, 3); }
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        el.textContent = Math.round(ease(p) * target) + suffix;
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      nums.forEach(function (el) { el.textContent = el.getAttribute('data-count') + (el.getAttribute('data-suffix') || ''); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); }
      });
    }, { threshold: 0.5 });
    nums.forEach(function (el) { io.observe(el); });
  })();
</script>

<!-- VÌ SAO CHỌN -->
<section class="alt">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secLoiIch.tag">{secLoiIch.tag}</span>
      <h2 class="sec-title" data-edit="t:secLoiIch.title">{secLoiIch.title}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:secLoiIch.intro">{secLoiIch.intro}</p>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="adv-grid">
      {loiIch.map((u, i) => (
        <div class="adv">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><h3 data-edit={`t:loiIch.${i}.t`}>{u.t}</h3><p data-edit={`t:loiIch.${i}.d`}>{u.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA GIỮA TRANG -->
<section>
  <div class="wrap">
    <div class="cta-mid">
      <div>
        <h2 data-edit="t:camXuc.big">{camXuc.big}</h2>
        <p data-edit="t:camXuc.small">{camXuc.small}</p>
      </div>
      <a class="btn-call" href={`tel:${TEL}`}>📞 {HOTLINE}</a>
    </div>
  </div>
</section>

<!-- QUY TRÌNH -->
<section id="quy-trinh" class="alt">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secQuyTrinh.tag">{secQuyTrinh.tag}</span>
      <h2 class="sec-title" data-edit="t:secQuyTrinh.title">{secQuyTrinh.title}</h2>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="steps">
      {quyTrinh.map((q, i) => (
        <div class="step">
          <div class="step-no" data-edit={`t:quyTrinh.${i}.s`}>{q.s}</div>
          <div class="n">
            {i === 0 ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c1 .3 2 .5 3 .6a2 2 0 0 1 1.7 2Z"/></svg>
            ) : i === 1 ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2h6v4H9z"/><path d="M5 6h14l1 14H4z"/><path d="M9 11h6M9 15h6"/></svg>
            ) : i === 2 ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="7" width="14" height="10" rx="1.5"/><path d="M15 10h4l3 3v4h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg>
            ) : (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
            )}
          </div>
          <h3 data-edit={`t:quyTrinh.${i}.t`}>{q.t}</h3>
          <p data-edit={`t:quyTrinh.${i}.d`}>{q.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- KINH NGHIỆM / BLOG — 6 bài mới nhất, tự cập nhật -->
{teaserPosts.length > 0 && (
<section id="kinh-nghiem">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secBlog.tag">{secBlog.tag}</span>
      <h2 class="sec-title" data-edit="t:secBlog.title">{secBlog.title}</h2>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="blog-grid">
      {teaserPosts.map((p, i) => (
        <a class="bcard" href={`/blog/${p.id}`}>
          <img class="bcard-img" src={anhBai(p, i)} alt={p.data.title} loading="lazy" />
          <div class="bcard-body">
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="more">Đọc tiếp →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="blog-all"><a href="/blog">Xem tất cả bài viết →</a></div>
  </div>
</section>
)}

<!-- BẢNG GIÁ -->
<section id="bang-gia" class="alt">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secBangGia.tag">{secBangGia.tag}</span>
      <h2 class="sec-title" data-edit="t:secBangGia.title">{secBangGia.title}</h2>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <p class="value-line">Cước một chuyến xe luôn <b>rẻ hơn nhiều</b> so với cái giá của một lô hàng tới trễ hay hư hỏng. Dưới đây là mức tham khảo để bạn dự trù chi phí — thuê <b>nguyên chuyến</b> từ TP.HCM đi các tỉnh, đơn vị: <b>triệu đồng / chuyến</b>.</p>
    <p class="swipe-hint">← vuốt ngang để xem đủ bảng →</p>
    <div class="price-wrap">
      <table class="price">
        <thead>
          <tr><th>Tuyến (TP.HCM đi)</th><th>Xe 8 tấn</th><th>Xe 10 tấn</th><th>Xe 15 tấn</th><th>Xe 20 tấn</th><th>Thời gian</th></tr>
        </thead>
        <tbody>
          {bangGia.map((r, i) => (
            <tr>
              <td data-edit={`t:bangGia.${i}.vung`}>{r.vung}</td>
              <td class="money tnum" data-edit={`t:bangGia.${i}.t8`}>{r.t8}</td>
              <td class="money tnum" data-edit={`t:bangGia.${i}.t10`}>{r.t10}</td>
              <td class="money tnum" data-edit={`t:bangGia.${i}.t15`}>{r.t15}</td>
              <td class="money tnum" data-edit={`t:bangGia.${i}.t20`}>{r.t20}</td>
              <td class="tg" data-edit={`t:bangGia.${i}.tg`}>{r.tg}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="price-note">
      <b>Lưu ý:</b> Giá trên là mức tham khảo cho chuyến nguyên xe, <b>chưa gồm VAT 8%</b>, phí bốc xếp tận nơi và phí đường cấm (nếu có).
      Giá thực tế thay đổi theo loại hàng, thời điểm và tuyến cụ thể. <b>Xe cẩu và container 30 tấn</b> báo giá riêng.
      Gọi <a href={`tel:${TEL}`} class="tnum" style="color:var(--brand-dark);font-weight:800;text-decoration:none">{HOTLINE}</a> để nhận báo giá chính xác trong 30 phút.
    </p>
    <div class="price-cta"><a class="btn-call" href={`tel:${TEL}`}>📞 Nhận báo giá chính xác</a></div>
  </div>
</section>

<!-- KHU VỰC -->
<section id="khu-vuc" class="area">
  <div class="wrap center" style="color:#fff; margin-bottom:0">
    <span class="step-tag" style="background:rgba(255,255,255,.12); color:#ffd9c9" data-edit="t:secKhuVuc.tag">{secKhuVuc.tag}</span>
    <h2 class="sec-title" style="color:#fff" data-edit="t:secKhuVuc.title">{secKhuVuc.title}</h2>
    <p style="color:#c7d3e2; margin:0" data-edit="t:secKhuVuc.intro">{secKhuVuc.intro}</p>
    <div class="chips">{khuVuc.map((k) => (<a href={areaHref(k)}>📍 {k.ten}</a>))}</div>
  </div>
</section>

<!-- KHÁCH HÀNG NÓI GÌ (giữ vì Danh Long chưa có, đây là nội dung thật đã có sẵn) -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secDanhGia.tag">{secDanhGia.tag}</span>
      <h2 class="sec-title" data-edit="t:secDanhGia.title">{secDanhGia.title}</h2>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="rev-grid">
      {danhGia.map((r, i) => (
        <div class="rev">
          <div class="stars">★★★★★</div>
          <p>"<span data-edit={`t:danhGia.${i}.noi`}>{r.noi}</span>"</p>
          <div class="who">
            <img src={r.avatar} data-edit-img={`t:danhGia.${i}.avatar`} alt={r.ten} width="46" height="46" loading="lazy">
            <div><b data-edit={`t:danhGia.${i}.ten`}>{r.ten}</b><br><small data-edit={`t:danhGia.${i}.chuc`}>{r.chuc}</small></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="alt">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secObjections.tag">{secObjections.tag}</span>
      <h2 class="sec-title" data-edit="t:secObjections.title">{secObjections.title}</h2>
      <div class="tl-line" set:html={ICON_TRUCK_LINE} />
    </div>
    <div class="faq">
      {objections.map((f, i) => (
        <details>
          <summary data-edit={`t:objections.${i}.q`}>{f.q}</summary>
          <div class="ans" data-edit={`t:objections.${i}.a`}>{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA CUỐI -->
<section>
  <div class="wrap">
    <div class="final">
      <h2 data-edit="t:ctaCuoi.title">{ctaCuoi.title}</h2>
      <p data-edit="t:ctaCuoi.body">{ctaCuoi.body}</p>
      <a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a>
    </div>
  </div>
</section>

<!-- FOOTER 4 CỘT + BẢN ĐỒ (kiểu Danh Long) -->
<footer class="site-foot">
  <div class="wrap ft-grid">
    <div>
      <div class="ft-logo"><img src={chung.logo} alt={COMPANY_FULL}></div>
      <p class="ft-legal">
        <b>{COMPANY_FULL}</b><br>
        Mã số thuế: <span class="tnum">{MST}</span><br>
        Địa chỉ: {ADDRESS}
      </p>
      <div class="ft-social">
        <a href={`https://zalo.me/${(_c.zalo || TEL).replace(/\s/g,'')}`} target="_blank" rel="noopener" aria-label="Zalo">💬</a>
        <a href={`tel:${TEL}`} aria-label="Gọi">📞</a>
      </div>
    </div>
    <div class="ft-col">
      <h4>Dịch vụ</h4>
      <ul>{dichVu.map((d) => (<li><a href="#dich-vu">{d.ten}</a></li>))}</ul>
    </div>
    <div class="ft-col">
      <h4>Liên hệ</h4>
      <ul class="ft-contact">
        <li>📞 Hotline: <a href={`tel:${TEL}`} class="tnum">{HOTLINE}</a></li>
        <li>💬 <a href={`https://zalo.me/${(_c.zalo || TEL).replace(/\s/g,'')}`} target="_blank" rel="noopener">Chat Zalo</a></li>
        <li>📍 {ADDRESS}</li>
      </ul>
    </div>
    <div class="ft-col">
      <h4>Bản đồ</h4>
      <div class="ft-map"><iframe src={mapEmbed} title="Bản đồ Vận Tải Lê Chung" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    </div>
  </div>
  <div class="copyright">© 2026 {COMPANY_FULL}. All rights reserved.</div>
</footer>

{/* Form liên hệ tự nổi (chỉ hiện khi có mã nhúng ở /quan-ly > Cài đặt) */}
{CONTACT_FORM && (
  <Fragment>
    <div id="cf-pop" data-delay={CONTACT_FORM_DELAY} aria-hidden="true" style="position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:16px">
      <div data-cf-bg style="position:absolute;inset:0;background:rgba(7,13,20,.6)"></div>
      <div role="dialog" aria-modal="true" style="position:relative;background:#fff;border-radius:18px;max-width:460px;width:100%;max-height:88vh;overflow:auto;padding:26px 22px 22px;box-shadow:0 30px 70px rgba(0,0,0,.35)">
        <button data-cf-x aria-label="Đóng" style="position:absolute;top:10px;right:12px;width:34px;height:34px;border:0;border-radius:50%;background:#eef2fb;color:#111;font-size:22px;line-height:1;cursor:pointer">&times;</button>
        <h3 style="font-size:20px;font-weight:800;color:#0a2540;margin:0 0 12px;padding-right:30px">{CONTACT_FORM_TITLE}</h3>
        <div set:html={CONTACT_FORM} />
      </div>
    </div>
    <script is:inline set:html={`(function(){var p=document.getElementById('cf-pop');if(!p)return;var delay=(parseInt(p.getAttribute('data-delay'),10)||6)*1000;function runScripts(){p.querySelectorAll('script').forEach(function(s){var n=document.createElement('script');for(var i=0;i<s.attributes.length;i++){n.setAttribute(s.attributes[i].name,s.attributes[i].value);}if(!s.src)n.textContent=s.textContent;document.body.appendChild(n);s.remove();});}function open(){if(sessionStorage.getItem('cf_pop_seen'))return;p.style.display='flex';p.setAttribute('aria-hidden','false');sessionStorage.setItem('cf_pop_seen','1');try{runScripts();}catch(e){}}function close(){p.style.display='none';p.setAttribute('aria-hidden','true');}setTimeout(open,delay);var x=p.querySelector('[data-cf-x]'),bg=p.querySelector('[data-cf-bg]');if(x)x.addEventListener('click',close);if(bg)bg.addEventListener('click',close);document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});})();`} />
  </Fragment>
)}

</body>
</html>
