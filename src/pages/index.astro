---
// Trang chủ Vận tải Lê Chung — VIẾT LẠI theo 16 BƯỚC BÁN HÀNG (Phạm Thành Long).
// Thương hiệu Lê Chung (KHÔNG bịa số liệu/lời khách). Menu dùng chung + bảng giá + blog.
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import trangchu from '../data/trangchu.json';
import chung from '../data/chung.json';

const HOTLINE = chung.hotline;
const TEL = chung.tel;

// ==== Cấu hình lấy từ /quan-ly (Cài đặt + Liên hệ) — để MỌI ô đều dùng thật ====
const _c = chung as { gscVerify?: string; bingVerify?: string; companyFull?: string; mst?: string; address?: string; zalo?: string; messenger?: string; fbPixel?: string; fbPixelId?: string; gaId?: string; contactForm?: string; contactFormTitle?: string; contactFormDelay?: string | number; favicon?: string };
// SEO: xác minh Google/Bing (nhận cả thẻ <meta ... content="..."> lẫn dãy mã trần)
const _gscRaw = _c.gscVerify || '';
const gscVerify = (_gscRaw.match(/content=["']([^"']+)["']/i)?.[1] || _gscRaw.replace(/<[^>]*>/g, '')).trim();
const _bingRaw = _c.bingVerify || '';
const bingVerify = (_bingRaw.match(/content=["']([^"']+)["']/i)?.[1] || _bingRaw.replace(/<[^>]*>/g, '')).trim();
// Liên hệ mở rộng (footer + Schema đọc từ đây; sửa ở /quan-ly > Liên hệ)
const COMPANY_FULL = _c.companyFull || 'CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG';
const MST = _c.mst || '0314664033';
const ADDRESS = _c.address || '77 Đường số 2A, Phường Bình Tân, TP. Hồ Chí Minh';
// Quảng cáo / đo lường / form (sửa ở /quan-ly > Cài đặt)
const FB_PIXEL = (_c.fbPixelId || _c.fbPixel || '').trim();
const GA_ID = ((_c.gaId || '').match(/\b(G-[A-Z0-9]+|UA-[0-9-]+|GTM-[A-Z0-9]+)\b/i)?.[0] || '').trim();
const CONTACT_FORM = _c.contactForm || '';
const CONTACT_FORM_TITLE = _c.contactFormTitle || 'Nhận tư vấn & báo giá';
const CONTACT_FORM_DELAY = Number(_c.contactFormDelay) || 6;
// Favicon (icon nhỏ ở tab trình duyệt, sửa ở /quan-ly > Liên hệ) — để trống thì giữ y như cũ (favicon.svg + favicon.ico mặc định)
const FAVICON = (_c.favicon || '').trim();
const FAVICON_TYPE: Record<string, string> = { svg: 'image/svg+xml', png: 'image/png', webp: 'image/webp', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };
const FAVICON_MIME = FAVICON_TYPE[FAVICON.split('.').pop()?.toLowerCase() || ''] || 'image/png';
// Schema doanh nghiệp
const _logoAbs = 'https://lechung.vn' + (chung.logo || '/favicon.svg');
const bizSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: COMPANY_FULL,
  url: 'https://lechung.vn/',
  telephone: (TEL || '').replace(/^0/, '+84'),
  image: _logoAbs,
  logo: _logoAbs,
  address: { '@type': 'PostalAddress', streetAddress: ADDRESS, addressLocality: 'TP. Hồ Chí Minh', addressCountry: 'VN' },
  areaServed: 'TP. Hồ Chí Minh và các tỉnh thành',
  ...(MST ? { vatID: MST } : {}),
};

// Khung ảnh/video đầu trang — anh Nhận tự đổi ở /admin (mục "Trang chủ").
// Có link YouTube => khung chiếu VIDEO; ô link để trống => khung hiện ẢNH.
function youtubeEmbed(url){
  if(!url) return '';
  const u = String(url).trim();
  let m;
  const id =
    (m = u.match(/[?&]v=([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/youtu\.be\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/embed\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/\/shorts\/([A-Za-z0-9_-]{11})/)) ? m[1] :
    (m = u.match(/^([A-Za-z0-9_-]{11})$/)) ? m[1] : '';
  return id ? 'https://www.youtube-nocookie.com/embed/' + id : '';
}
const heroVideoUrl = youtubeEmbed(trangchu && trangchu.heroVideo);
const heroAnh = (trangchu && trangchu.heroAnh) || '/img/doi-xe.webp';
// Ảnh xem trước khi chia sẻ link trang chủ (Facebook/Zalo) — đường dẫn đầy đủ, mặc định ảnh đầu trang
const ogImage = /^https?:\/\//.test(heroAnh) ? heroAnh : ('https://lechung.vn' + heroAnh);
const heroEyebrow = trangchu.heroEyebrow;
const heroH1 = trangchu.heroH1;
const heroLead = trangchu.heroLead;
const heroTicks = trangchu.heroTicks || [];
const heroBtnGia = trangchu.heroBtnGia;
const dichVuTag = trangchu.dichVuTag;
const dichVuTitle = trangchu.dichVuTitle;
const dichVuIntro = trangchu.dichVuIntro;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.ngayDang.valueOf() <= Date.now())
  .sort((a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf());
const norm = (s) => (s || '').toLowerCase();
function matchPost(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return '/blog/' + hit.id;
  }
  return posts.length ? '/blog/' + posts[0].id : '/blog';
}
function findId(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return hit.id;
  }
  return null;
}
function areaHref(a) {
  if (posts.find((p) => p.id === a.slug)) return '/blog/' + a.slug;
  const id = findId(a.kw);
  return id ? '/blog/' + id : '#khu-vuc';
}
const teaserPosts = posts.slice(0, 3);

// Dữ liệu các mục — đọc từ trangchu.json (sửa qua /admin)
const noiDau = trangchu.noiDau || [];
const uyTin = trangchu.uyTin || [];
const truoc = trangchu.truoc || [];
const sau = trangchu.sau || [];
const loiIch = trangchu.loiIch || [];

// BƯỚC 6 (tiếp) — Dịch vụ / đội xe
const dichVuKeys = [
  ['8 tấn','tải trọng','loại xe'],
  ['10 tấn','tải trọng','loại xe'],
  ['15 tấn','nguyên chuyến','đi tỉnh'],
  ['20 tấn','container','nguyên chuyến'],
  ['cẩu','bốc xếp','nâng hạ'],
  ['container','đầu kéo','cảng','nguyên chuyến'],
];
const dichVu = (trangchu.dichVu || []).map((d, i) => ({ ...d, key: dichVuKeys[i] || [] }));

const khuVuc = [
  { ten: 'TP. Hồ Chí Minh', slug: 'van-chuyen-hang-hoa-noi-thanh-tphcm', kw: ['nội thành', 'tphcm', 'hồ chí minh', 'sài gòn'] },
  { ten: 'Miền Đông Nam Bộ', slug: 'van-chuyen-hang-di-mien-dong-nam-bo', kw: ['miền đông', 'đồng nai', 'bình dương', 'vũng tàu'] },
  { ten: 'Miền Tây Nam Bộ', slug: 'van-chuyen-hang-di-mien-tay', kw: ['miền tây', 'cần thơ', 'long an', 'tiền giang'] },
  { ten: 'Tây Nguyên', slug: 'van-chuyen-hang-di-tay-nguyen', kw: ['tây nguyên', 'đắk lắk', 'gia lai', 'lâm đồng', 'pleiku'] },
  { ten: 'Miền Trung', slug: 'van-chuyen-hang-di-mien-trung', kw: ['miền trung', 'đà nẵng', 'huế', 'quy nhơn', 'nha trang'] },
  { ten: 'Miền Bắc', slug: 'van-chuyen-hang-di-mien-bac', kw: ['miền bắc', 'hà nội', 'hải phòng'] },
];

const quyTrinh = trangchu.quyTrinh || [];
const giaTriLon = trangchu.giaTriLon || [];
const objections = trangchu.objections || [];
const truCot = trangchu.truCot || [];

// BƯỚC 13 — Bảng giá tham khảo (đã +1%, anh Nhận đã duyệt)
const bangGia = trangchu.bangGia || [];

// BƯỚC 14 — Quà tặng / cam kết thêm
const quaTang = trangchu.quaTang || [];

// BƯỚC 15 — Testimonial (lời khách; anh Nhận thay bằng khách thật khi có)
const danhGia = trangchu.danhGia || [];

// Nhãn + tiêu đề các mục (sửa qua /admin)
const badges = trangchu.badges || [];
const secNoiDau = trangchu.secNoiDau || {};
const secUyTin = trangchu.secUyTin || {};
const secTruocSau = trangchu.secTruocSau || {};
const secLoiIch = trangchu.secLoiIch || {};
const secKhuVuc = trangchu.secKhuVuc || {};
const camXuc = trangchu.camXuc || {};
const secQuyTrinh = trangchu.secQuyTrinh || {};
const secGiaTriLon = trangchu.secGiaTriLon || {};
const secObjections = trangchu.secObjections || {};
const secTruCot = trangchu.secTruCot || {};
const gioiHan = trangchu.gioiHan || {};
const secBangGia = trangchu.secBangGia || {};
const secQuaTang = trangchu.secQuaTang || {};
const secDanhGia = trangchu.secDanhGia || {};
const secBlog = trangchu.secBlog || {};
const ctaCuoi = trangchu.ctaCuoi || {};
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{FAVICON ? <link rel="icon" type={FAVICON_MIME} href={FAVICON} /> : <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /></>}
<title>Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung {HOTLINE}</title>
<meta name="description" content={`Thuê xe tải chở hàng TP.HCM đi toàn quốc — Vận Tải Lê Chung: đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Báo giá miễn phí ${HOTLINE}.`}>
<link rel="canonical" href="https://lechung.vn/">
<meta property="og:title" content="Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung">
<meta property="og:description" content={`Đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Hotline ${HOTLINE}.`}>
<meta property="og:type" content="website">
<meta property="og:url" content="https://lechung.vn/">
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Vận Tải Lê Chung">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Thuê xe tải chở hàng TPHCM đi toàn quốc — Vận Tải Lê Chung">
<meta name="twitter:description" content={`Đội xe hơn 100 chiếc 8-20 tấn, xe cẩu, container. An toàn, đúng hẹn, không phát sinh. Hotline ${HOTLINE}.`}>
<meta name="twitter:image" content={ogImage}>
{gscVerify && <meta name="google-site-verification" content={gscVerify} />}
{bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script type="application/ld+json" is:inline set:html={JSON.stringify(bizSchema)} />
{/* Facebook Pixel (chỉ chạy khi có mã ở /quan-ly > Cài đặt) */}
{FB_PIXEL && (<script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${FB_PIXEL}');fbq('track','PageView');`} />)}
{FB_PIXEL && (<noscript set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${FB_PIXEL}&ev=PageView&noscript=1"/>`} />)}
{/* Google Analytics 4 (chỉ chạy khi có mã G-XXXX hợp lệ) */}
{GA_ID && <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />}
{GA_ID && (<script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${GA_ID}');`} />)}
<style is:global>
  :root{
    --bg:#ffffff; --panel:#f7f9fc; --panel-2:#eef2f8; --card:#ffffff; --line:#e6ebf3;
    --text:#0a0b0d; --text-soft:#3a3f45; --muted:#6b7280;
    --brand:#ff6b35; --brand-dark:#df4d1c; --brand-light:#ff9466; --brand-tint:#fff1ea;
    --navy:#081019; --navy-2:#0e1f31; --navy-3:#15324a; --ink:#05070a; --gold:#f0b23e;
    --danger:#d0483a;
    --shadow-sm:0 1px 2px rgba(5,8,12,.05), 0 3px 10px rgba(5,8,12,.05);
    --shadow:0 4px 16px rgba(5,8,12,.07), 0 16px 44px rgba(5,8,12,.10);
    --shadow-lg:0 24px 64px rgba(5,8,12,.24);
    --radius:14px; --radius-lg:22px;
  }
  /* Nền TRẮNG cho MỌI người — anh Nhận chọn (đã bỏ chế độ tối theo máy). Tông đen/navy footer & khối tối làm ĐẬM hơn cho sang. */
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Manrope','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif; line-height:1.65; -webkit-font-smoothing:antialiased}
  .wrap{max-width:1160px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  img{max-width:100%; display:block}
  .tnum{font-variant-numeric:tabular-nums}
  .eyebrow{color:var(--brand-dark); font-weight:800; font-size:13.5px; letter-spacing:.09em; text-transform:uppercase; margin:0 0 8px}
  .step-tag{display:inline-block; color:var(--brand-dark); background:var(--brand-tint); font-weight:800; font-size:12px; letter-spacing:.05em; padding:5px 12px; border-radius:999px; margin:0 0 12px}
  .sec-title{font-size:clamp(24px,3.6vw,36px); font-weight:900; letter-spacing:-.02em; margin:0 0 14px; line-height:1.18; color:var(--ink)}
  .btn-call{display:inline-flex; align-items:center; gap:9px; background:linear-gradient(160deg,var(--brand),var(--brand-dark)); color:#fff; text-decoration:none; font-weight:800; font-size:16px; padding:14px 28px; border-radius:12px; box-shadow:0 10px 26px rgba(223,77,28,.35); border:0; cursor:pointer; transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease, filter .2s ease}
  .btn-call:hover{filter:brightness(1.06); transform:translateY(-2px); box-shadow:0 16px 34px rgba(223,77,28,.42)}

  /* HERO — Bước 1+2 */
  .hero{position:relative; background:radial-gradient(1100px 620px at 82% -12%, rgba(255,107,53,.14), transparent 60%), radial-gradient(900px 500px at -10% 110%, rgba(8,16,25,.07), transparent 60%), linear-gradient(180deg,#ffffff,#f5f8fc); color:var(--ink); overflow:hidden; border-bottom:1px solid var(--line)}
  .hero::before{content:''; position:absolute; inset:0; background-image:radial-gradient(rgba(8,16,25,.06) 1px, transparent 1px); background-size:26px 26px; -webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.5),transparent 70%); mask-image:linear-gradient(180deg,rgba(0,0,0,.5),transparent 70%); pointer-events:none}
  .hero .wrap{position:relative; display:grid; grid-template-columns:1.05fr .95fr; gap:48px; align-items:center; padding-top:64px; padding-bottom:70px}
  .hero h1{font-size:clamp(29px,4.6vw,48px); font-weight:900; line-height:1.1; letter-spacing:-.025em; margin:0 0 16px; text-wrap:balance; color:var(--ink)}
  .hero p.lead{color:var(--text-soft); font-size:17px; margin:0 0 22px; max-width:560px}
  .hero .ticks{list-style:none; margin:0 0 26px; padding:0; display:grid; gap:10px; max-width:540px}
  .hero .ticks li{position:relative; padding-left:30px; color:var(--text-soft); font-size:15px; font-weight:700}
  .hero .ticks li::before{content:'✓'; position:absolute; left:0; top:-1px; width:21px;height:21px; background:linear-gradient(160deg,var(--brand),var(--brand-dark)); color:#fff; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:900; box-shadow:0 4px 10px rgba(223,77,28,.35)}
  .hero-cta{display:flex; gap:14px; flex-wrap:wrap; align-items:center}
  .hero-cta .ghost{display:inline-flex; align-items:center; gap:8px; color:var(--ink); text-decoration:none; font-weight:800; font-size:15px; padding:13px 24px; border-radius:12px; border:1.5px solid rgba(8,16,25,.18); transition:border-color .2s ease, background .2s ease, transform .2s ease}
  .hero-cta .ghost:hover{background:rgba(8,16,25,.05); border-color:var(--ink); transform:translateY(-2px)}
  .hero-visual{position:relative}
  .hero-photo{border-radius:var(--radius-lg); box-shadow:var(--shadow-lg); width:100%; height:100%; object-fit:cover; aspect-ratio:4/3}
  .hero-video{position:relative; width:100%; aspect-ratio:16/9; border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg); background:var(--ink)}
  .hero-video iframe{position:absolute; inset:0; width:100%; height:100%; border:0}
  .hero-stat{position:absolute; left:-18px; bottom:-22px; background:var(--navy); color:#fff; border-radius:16px; padding:16px 20px; box-shadow:0 20px 46px rgba(5,8,12,.4); display:flex; align-items:center; gap:12px; border:1px solid rgba(255,255,255,.08)}
  .hero-stat .n{font-size:26px; font-weight:900; color:var(--brand-light); line-height:1}
  .hero-stat .t{font-size:12.5px; font-weight:700; color:#cbd6e2; line-height:1.3; max-width:120px}
  @media(max-width:820px){
    .hero .wrap{grid-template-columns:1fr; gap:30px; padding-top:40px; padding-bottom:42px; text-align:center}
    .hero .eyebrow{margin-left:auto;margin-right:auto}
    .hero p.lead{margin-left:auto;margin-right:auto}
    .hero .ticks{margin-left:auto;margin-right:auto; text-align:left; display:inline-grid}
    .hero-cta{justify-content:center}
    .hero-photo{aspect-ratio:16/10}
    .hero-stat{left:50%; transform:translateX(-50%); bottom:-18px}
  }
  /* badges */
  .badges{background:var(--navy); color:#fff; position:relative; z-index:1}
  .badges .wrap{display:flex; flex-wrap:wrap; justify-content:center; gap:12px 40px; padding:16px 20px; font-weight:700; font-size:14.5px; text-align:center}
  .badges span{display:inline-flex; align-items:center; gap:9px; color:#e7edf4}
  .badges span::before{content:'✓'; font-weight:900; color:var(--brand-light); width:19px; height:19px; border-radius:50%; background:rgba(255,148,102,.16); display:inline-flex; align-items:center; justify-content:center; font-size:11px}

  /* stats — con số thật, nhắc lại cho ấn tượng */
  .stats{padding:38px 0 6px}
  .stats .grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px}
  @media(max-width:720px){.stats .grid{grid-template-columns:repeat(2,1fr); gap:26px 16px}}
  .stat-card{text-align:center; padding:0 8px; position:relative}
  .stat-card::before{content:''; position:absolute; left:0; top:6px; bottom:6px; width:1px; background:var(--line)}
  .stat-card:first-child::before{display:none}
  @media(max-width:720px){.stat-card:nth-child(odd)::before{display:none}}
  .stat-card .num{font-size:clamp(28px,4vw,42px); font-weight:900; color:var(--ink); letter-spacing:-.02em; line-height:1}
  .stat-card .num b{color:var(--brand-dark)}
  .stat-card .lbl{margin-top:8px; font-size:13.5px; font-weight:700; color:var(--muted); line-height:1.35}

  section{padding:64px 0}
  .center{text-align:center; max-width:700px; margin:0 auto 40px}

  .grid4{display:grid; grid-template-columns:repeat(4,1fr); gap:18px}
  @media(max-width:900px){.grid4{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:520px){.grid4{grid-template-columns:1fr}}
  .adv-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:18px}
  @media(max-width:640px){.adv-grid{grid-template-columns:1fr}}

  /* pain / value cards */
  .pain{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); transition:box-shadow .3s ease, transform .3s ease, border-color .3s ease}
  .pain:hover{box-shadow:var(--shadow); transform:translateY(-4px); border-color:#d9e0ea}
  .pain .ic{width:48px;height:48px;border-radius:13px;background:linear-gradient(160deg,var(--brand-tint),#ffe2d0);color:var(--brand-dark);display:grid;place-items:center;margin-bottom:14px}
  .pain h3{margin:0 0 8px; font-size:16.5px; font-weight:800; color:var(--ink)}
  .pain p{margin:0; color:var(--text-soft); font-size:14px}

  /* advantages / uy tín / lợi ích */
  .adv{display:flex; gap:16px; align-items:flex-start; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:20px 22px; box-shadow:var(--shadow-sm); transition:box-shadow .3s ease, transform .3s ease}
  .adv:hover{box-shadow:var(--shadow); transform:translateY(-3px)}
  .adv .ic{flex:0 0 auto; width:46px;height:46px;border-radius:12px;background:linear-gradient(160deg,var(--navy-3),var(--navy));color:#fff;display:grid;place-items:center; box-shadow:0 6px 16px rgba(5,8,12,.28)}
  .adv h3{margin:0 0 6px; font-size:16px; font-weight:800; color:var(--ink)}
  .adv p{margin:0; color:var(--text-soft); font-size:14px}

  /* before / after — Bước 5 */
  .ba{display:grid; grid-template-columns:1fr 1fr; gap:22px}
  @media(max-width:720px){.ba{grid-template-columns:1fr}}
  .ba .col{border-radius:var(--radius-lg); padding:28px; border:1px solid var(--line); background:var(--card); box-shadow:var(--shadow-sm)}
  .ba .before{border-top:4px solid var(--danger); background:linear-gradient(180deg,rgba(208,72,58,.05),var(--card) 120px)}
  .ba .after{border-top:4px solid var(--brand); background:linear-gradient(180deg,rgba(255,107,53,.06),var(--card) 120px); box-shadow:var(--shadow)}
  .ba .col h3{margin:0 0 16px; font-size:18.5px; font-weight:900; color:var(--ink)}
  .ba ul{margin:0; padding:0; list-style:none}
  .ba li{position:relative; padding-left:30px; margin-bottom:12px; color:var(--text-soft); font-size:14.5px}
  .ba .before li::before{content:'✕'; position:absolute; left:0; color:var(--danger); font-weight:900}
  .ba .after li::before{content:'✓'; position:absolute; left:0; color:var(--brand-dark); font-weight:900}

  /* services */
  .svc-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){.svc-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.svc-grid{grid-template-columns:1fr}}
  .svc{background:var(--card); border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:box-shadow .3s ease, transform .3s ease}
  .svc:hover{transform:translateY(-5px)}
  .svc img{width:100%; aspect-ratio:16/10; object-fit:cover}
  .svc .body{padding:20px 20px 22px; display:flex; flex-direction:column; flex:1}
  .svc h3{margin:0 0 10px; font-size:17px; font-weight:800; color:var(--ink)}
  .svc ul{margin:0 0 16px; padding:0; list-style:none; flex:1}
  .svc li{position:relative; padding-left:22px; margin-bottom:7px; font-size:14px; color:var(--text-soft)}
  .svc li::before{content:'✓'; position:absolute; left:0; color:var(--brand-dark); font-weight:900}
  .svc .foot{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .svc a.more{display:inline-flex; gap:7px; align-items:center; background:var(--brand-tint); color:var(--brand-dark); text-decoration:none; font-weight:800; font-size:14px; padding:9px 15px; border-radius:9px; transition:background .2s ease, color .2s ease}
  .svc a.more:hover{background:var(--brand); color:#fff}
  .svc a.readmore{color:var(--brand-dark); font-weight:800; font-size:13.5px; text-decoration:none}
  .svc a.readmore:hover{text-decoration:underline}

  /* area */
  .area{background:linear-gradient(160deg,var(--navy),var(--ink)); color:#fff}
  .area .chips{display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:20px}
  .area .chips span,
  .area .chips a{background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16); padding:10px 18px; border-radius:999px; font-weight:700; font-size:14.5px; color:#fff; text-decoration:none; transition:background .2s ease, border-color .2s ease, transform .2s ease}
  .area .chips a:hover{background:var(--brand); border-color:var(--brand); transform:translateY(-2px)}

  /* emotion banner — Bước 7 */
  .emotion{background:linear-gradient(160deg,var(--navy),var(--ink)); color:#fff; border-radius:var(--radius-lg); padding:48px 32px; text-align:center; box-shadow:var(--shadow-lg)}
  .emotion p{max-width:740px; margin:0 auto; font-size:clamp(18px,2.6vw,25px); font-weight:700; line-height:1.5; color:#eef3f8; text-wrap:balance}
  .emotion .small{font-size:15px; font-weight:600; color:#9fb0c2; margin-top:16px}

  /* process */
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:18px}
  @media(max-width:820px){.steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:480px){.steps{grid-template-columns:1fr}}
  .step{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); position:relative; transition:box-shadow .3s ease, transform .3s ease}
  .step:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .step .n{width:46px;height:46px;border-radius:13px;background:linear-gradient(160deg,var(--brand),var(--brand-dark));color:#fff;font-weight:900;display:grid;place-items:center;font-size:18px;margin-bottom:14px; box-shadow:0 8px 18px rgba(223,77,28,.32)}
  .step h3{margin:0 0 6px; font-size:16px; font-weight:800; color:var(--ink)}
  .step p{margin:0; color:var(--text-soft); font-size:13.8px}

  /* pillars — Bước 11 */
  .pillars{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
  @media(max-width:720px){.pillars{grid-template-columns:1fr}}
  .pillar{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:28px 24px; text-align:center; box-shadow:var(--shadow-sm); transition:box-shadow .3s ease, transform .3s ease}
  .pillar:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .pillar .big{font-size:21px; font-weight:900; color:var(--brand-dark); margin:0 0 8px}
  .pillar p{margin:0; color:var(--text-soft); font-size:14px}

  /* scarcity — Bước 12 */
  .scarcity{background:linear-gradient(135deg,var(--brand-tint),#ffe5d6); border:1px solid #ffcaa8; border-radius:var(--radius-lg); padding:28px 26px; display:flex; gap:20px; align-items:flex-start; box-shadow:var(--shadow-sm)}
  .scarcity .ic{flex:0 0 auto; width:48px;height:48px;border-radius:13px;background:linear-gradient(160deg,var(--brand),var(--brand-dark));color:#fff;display:grid;place-items:center;font-weight:900;font-size:21px; box-shadow:0 8px 20px rgba(223,77,28,.35)}
  .scarcity h3{margin:0 0 6px; font-size:18px; font-weight:800; color:var(--ink)}
  .scarcity p{margin:0; color:var(--text-soft); font-size:14.5px}

  /* pricing — Bước 13 */
  .price-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow); background:var(--card)}
  table.price{width:100%; border-collapse:collapse; min-width:640px; font-size:14.5px}
  table.price thead th{background:linear-gradient(160deg,var(--navy-3),var(--navy)); color:#fff; font-weight:800; padding:15px 16px; text-align:center; font-size:14px}
  table.price thead th:first-child{text-align:left; border-top-left-radius:var(--radius-lg)}
  table.price thead th:last-child{border-top-right-radius:var(--radius-lg)}
  table.price tbody td{padding:14px 16px; border-top:1px solid var(--line); text-align:center; color:var(--text-soft)}
  table.price tbody td:first-child{text-align:left; font-weight:700; color:var(--ink)}
  table.price tbody tr:nth-child(even){background:color-mix(in srgb,var(--brand-tint) 45%, transparent)}
  table.price tbody tr:hover{background:var(--panel-2)}
  table.price .money{font-weight:800; color:var(--brand-dark); font-variant-numeric:tabular-nums}
  table.price tbody td.tg{color:var(--muted); font-size:13px}
  .price-note{margin:18px auto 0; max-width:820px; color:var(--muted); font-size:13.5px; text-align:center}
  .price-note b{color:var(--text-soft)}
  .price-cta{text-align:center; margin-top:24px}
  .swipe-hint{display:none}
  @media(max-width:560px){
    table.price{min-width:520px; font-size:13px}
    table.price thead th{padding:12px 10px; font-size:12.5px}
    table.price tbody td{padding:11px 10px}
    .swipe-hint{display:block; text-align:center; color:var(--muted); font-size:12.5px; margin:0 0 10px}
  }
  .value-line{text-align:center; max-width:760px; margin:0 auto 28px; font-size:17px; color:var(--text-soft)}
  .value-line b{color:var(--ink)}

  /* bonus — Bước 14 */
  .bonus{background:linear-gradient(160deg,var(--navy),var(--ink)); color:#fff; border-radius:var(--radius-lg); padding:38px 32px; box-shadow:var(--shadow-lg)}
  .bonus .sec-title{color:#fff}
  .bonus ul{margin:18px 0 0; padding:0; list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:14px 28px}
  @media(max-width:640px){.bonus ul{grid-template-columns:1fr}}
  .bonus li{position:relative; padding-left:32px; font-size:15px; color:#dbe6f2; line-height:1.5}
  .bonus li::before{content:'✓'; position:absolute; left:0; top:0; width:22px;height:22px; background:linear-gradient(160deg,var(--brand),var(--brand-dark)); color:#fff; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:900}

  /* testimonials */
  .rev-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){.rev-grid{grid-template-columns:1fr}}
  .rev{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:box-shadow .3s ease, transform .3s ease}
  .rev:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .rev .stars{color:var(--gold); font-size:15px; letter-spacing:2px; margin-bottom:10px}
  .rev p{margin:0 0 16px; font-size:14.5px; color:var(--text-soft); flex:1}
  .rev .who{display:flex; align-items:center; gap:12px}
  .rev .who img{width:48px;height:48px;border-radius:50%; object-fit:cover; border:2px solid var(--brand-tint)}
  .rev .who b{font-size:14.5px; color:var(--ink)}
  .rev .who small{color:var(--muted); font-size:12.5px}

  /* blog teaser */
  .blog-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
  @media(max-width:900px){.blog-grid{grid-template-columns:1fr}}
  .bcard{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; transition:box-shadow .3s ease, transform .3s ease}
  .bcard:hover{box-shadow:var(--shadow); transform:translateY(-4px)}
  .bcard .tag{color:var(--brand-dark); font-weight:800; font-size:12px; letter-spacing:.06em; text-transform:uppercase; margin:0 0 8px}
  .bcard h3{margin:0 0 8px; font-size:16.5px; font-weight:800; line-height:1.35; color:var(--ink)}
  .bcard h3 a{text-decoration:none}
  .bcard h3 a:hover{color:var(--brand-dark)}
  .bcard p{margin:0 0 14px; color:var(--text-soft); font-size:14px; flex:1}
  .bcard .more{color:var(--brand-dark); font-weight:800; font-size:14px; text-decoration:none}
  .bcard .more:hover{text-decoration:underline}
  .blog-all{text-align:center; margin-top:28px}
  .blog-all a{display:inline-flex; align-items:center; gap:8px; color:var(--brand-dark); font-weight:800; text-decoration:none; border:1.5px solid var(--brand); padding:12px 24px; border-radius:12px; transition:background .2s ease, color .2s ease, transform .2s ease}
  .blog-all a:hover{background:var(--brand); color:#fff; transform:translateY(-2px)}

  /* faq / objections */
  .faq{max-width:820px; margin:0 auto}
  .faq details{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:0; margin-bottom:12px; box-shadow:var(--shadow-sm); overflow:hidden; transition:box-shadow .25s ease}
  .faq details[open]{box-shadow:var(--shadow)}
  .faq summary{cursor:pointer; list-style:none; padding:19px 22px; font-weight:800; font-size:15.5px; color:var(--ink); display:flex; justify-content:space-between; gap:14px; align-items:center}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+'; color:var(--brand-dark); font-size:22px; font-weight:400; flex:0 0 auto}
  .faq details[open] summary::after{content:'−'}
  .faq .ans{padding:0 22px 20px; color:var(--text-soft); font-size:14.5px}

  /* final cta — Bước 16 */
  .final{background:linear-gradient(155deg,var(--brand),var(--brand-dark) 70%,#b8380f); color:#fff; border-radius:var(--radius-lg); padding:48px 32px; text-align:center; box-shadow:0 30px 70px rgba(223,77,28,.32)}
  .final h2{margin:0 0 10px; font-size:clamp(24px,3.6vw,36px); font-weight:900}
  .final p{margin:0 0 24px; font-size:16px; opacity:.95}
  .final .btn-call{background:#fff; color:var(--brand-dark); box-shadow:0 12px 30px rgba(5,8,12,.25)}
  .final .btn-call:hover{background:var(--ink); color:#fff}

  /* footer */
  .site-foot{background:linear-gradient(180deg,var(--navy),var(--ink)); color:#aebccb; padding:52px 0 30px; font-size:14px}
  .site-foot .cols{display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:32px 40px}
  @media(max-width:760px){.site-foot .cols{grid-template-columns:1fr; gap:28px}}
  .site-foot .about b.brand{color:#fff; font-size:17px; display:block; margin-bottom:10px; letter-spacing:-.01em}
  .site-foot .about p{margin:0 0 14px; color:#93a3b4; line-height:1.6}
  .site-foot .about .line{display:flex; align-items:center; gap:8px; margin-bottom:8px; color:#c3cfdb}
  .site-foot h4{color:#fff; font-size:14px; font-weight:800; margin:0 0 14px; letter-spacing:.02em; text-transform:uppercase; opacity:.85}
  .site-foot a{color:#aebccb; text-decoration:none; transition:color .2s ease}
  .site-foot a:hover{color:var(--brand-light)}
  .site-foot .navcol a{display:block; margin-bottom:10px}
  .site-foot .cr{border-top:1px solid rgba(255,255,255,.08); margin-top:34px; padding-top:18px; font-size:12.5px; color:#70869a; display:flex; flex-wrap:wrap; gap:10px 20px; justify-content:space-between; align-items:center}
</style>
</head>
<body>

<Header />

<!-- BƯỚC 1 + 2: HEADLINE + SUB-HEADLINE (HERO) -->
<div class="hero">
  <div class="wrap">
    <div>
      <p class="eyebrow" data-edit="t:heroEyebrow">{heroEyebrow}</p>
      <h1 data-edit="t:heroH1">{heroH1}</h1>
      <p class="lead" data-edit="t:heroLead">{heroLead}</p>
      <ul class="ticks">
        {heroTicks.map((t, i) => (<li data-edit={`t:heroTicks.${i}`}>{t}</li>))}
      </ul>
      <div class="hero-cta">
        <a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a>
        <a class="ghost" href="#bang-gia" data-edit="t:heroBtnGia">{heroBtnGia}</a>
      </div>
    </div>
    <div class="hero-visual">
      {heroVideoUrl ? (
        <div class="hero-video">
          <iframe src={heroVideoUrl} title="Video giới thiệu Vận tải Lê Chung" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      ) : (
        <img class="hero-photo" src={heroAnh} data-edit-img="t:heroAnh" alt="Đội hình xe tải chuyên nghiệp của Vận tải Lê Chung" width="640" height="480" />
      )}
      <div class="hero-stat">
        <span class="n">100+</span>
        <span class="t">Đầu xe sở hữu riêng, sẵn sàng điều phối</span>
      </div>
    </div>
  </div>
</div>

<!-- Dải cam bằng chứng nhanh -->
<div class="badges">
  <div class="wrap">
    {badges.map((b, i) => (<span data-edit={`t:badges.${i}`}>{b}</span>))}
  </div>
</div>

<!-- Dải số liệu — nhắc lại các con số thật đã nói ở trên cho dễ nhớ -->
<div class="stats">
  <div class="wrap grid">
    <div class="stat-card"><div class="num"><b>100+</b></div><div class="lbl">Đầu xe sở hữu riêng</div></div>
    <div class="stat-card"><div class="num"><b>63</b></div><div class="lbl">Tỉnh thành phục vụ</div></div>
    <div class="stat-card"><div class="num"><b>10+</b></div><div class="lbl">Năm kinh nghiệm vận tải</div></div>
    <div class="stat-card"><div class="num"><b>24/7</b></div><div class="lbl">Nhận điện thoại &amp; điều xe</div></div>
  </div>
</div>

<!-- BƯỚC 3: NỖI ĐAU -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secNoiDau.tag">{secNoiDau.tag}</span>
      <h2 class="sec-title" data-edit="t:secNoiDau.title">{secNoiDau.title}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:secNoiDau.intro">{secNoiDau.intro}</p>
    </div>
    <div class="grid4">
      {noiDau.map((n, i) => (
        <div class="pain">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg></div>
          <h3 data-edit={`t:noiDau.${i}.t`}>{n.t}</h3>
          <p data-edit={`t:noiDau.${i}.d`}>{n.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 4: UY TÍN NGƯỜI BÁN -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secUyTin.tag">{secUyTin.tag}</span>
      <h2 class="sec-title" data-edit="t:secUyTin.title">{secUyTin.title}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:secUyTin.intro">{secUyTin.intro}</p>
    </div>
    <div class="adv-grid">
      {uyTin.map((u, i) => (
        <div class="adv">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><h3 data-edit={`t:uyTin.${i}.t`}>{u.t}</h3><p data-edit={`t:uyTin.${i}.d`}>{u.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 5: BEFORE – AFTER -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secTruocSau.tag">{secTruocSau.tag}</span>
      <h2 class="sec-title" data-edit="t:secTruocSau.title">{secTruocSau.title}</h2>
    </div>
    <div class="ba">
      <div class="col before">
        <h3 data-edit="t:secTruocSau.truocTitle">{secTruocSau.truocTitle}</h3>
        <ul>{truoc.map((t, i) => (<li data-edit={`t:truoc.${i}`}>{t}</li>))}</ul>
      </div>
      <div class="col after">
        <h3 data-edit="t:secTruocSau.sauTitle">{secTruocSau.sauTitle}</h3>
        <ul>{sau.map((t, i) => (<li data-edit={`t:sau.${i}`}>{t}</li>))}</ul>
      </div>
    </div>
  </div>
</section>

<!-- BƯỚC 6: LỢI ÍCH -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secLoiIch.tag">{secLoiIch.tag}</span>
      <h2 class="sec-title" data-edit="t:secLoiIch.title">{secLoiIch.title}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:secLoiIch.intro">{secLoiIch.intro}</p>
    </div>
    <div class="adv-grid">
      {loiIch.map((u, i) => (
        <div class="adv">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div><h3 data-edit={`t:loiIch.${i}.t`}>{u.t}</h3><p data-edit={`t:loiIch.${i}.d`}>{u.d}</p></div>
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:28px"><a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a></div>
  </div>
</section>

<!-- BƯỚC 6 (tiếp): DỊCH VỤ / ĐỘI XE -->
<section id="dich-vu">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:dichVuTag">{dichVuTag}</span>
      <h2 class="sec-title" data-edit="t:dichVuTitle">{dichVuTitle}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:dichVuIntro">{dichVuIntro}</p>
    </div>
    <div class="svc-grid">
      {dichVu.map((d, i) => (
        <div class="svc">
          <img src={d.img} data-edit-img={`t:dichVu.${i}.img`} alt={d.ten} width="360" height="225" loading="lazy">
          <div class="body">
            <h3 data-edit={`t:dichVu.${i}.ten`}>{d.ten}</h3>
            <ul>{d.bullets.map((b, j) => (<li data-edit={`t:dichVu.${i}.bullets.${j}`}>{b}</li>))}</ul>
            <div class="foot">
              <a class="more" href={`tel:${TEL}`}>Nhận báo giá →</a>
              <a class="readmore" href={matchPost(d.key)}>Xem thêm ↗</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Khu vực phục vụ -->
<section id="khu-vuc" class="area">
  <div class="wrap center" style="color:#fff; margin-bottom:0">
    <span class="step-tag" style="background:rgba(255,255,255,.12); color:#ffd9c9" data-edit="t:secKhuVuc.tag">{secKhuVuc.tag}</span>
    <h2 class="sec-title" style="color:#fff" data-edit="t:secKhuVuc.title">{secKhuVuc.title}</h2>
    <p style="color:#c7d3e2; margin:0" data-edit="t:secKhuVuc.intro">{secKhuVuc.intro}</p>
    <div class="chips">{khuVuc.map((k) => (<a href={areaHref(k)}>{k.ten}</a>))}</div>
  </div>
</section>

<!-- BƯỚC 7: TẠO CẢM XÚC -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="emotion">
      <p data-edit="t:camXuc.big">{camXuc.big}</p>
      <div class="small" data-edit="t:camXuc.small">{camXuc.small}</div>
    </div>
  </div>
</section>

<!-- BƯỚC 8: RÕ RÀNG – QUY TRÌNH -->
<section id="quy-trinh">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secQuyTrinh.tag">{secQuyTrinh.tag}</span>
      <h2 class="sec-title" data-edit="t:secQuyTrinh.title">{secQuyTrinh.title}</h2>
    </div>
    <div class="steps">
      {quyTrinh.map((q, i) => (
        <div class="step">
          <div class="n" data-edit={`t:quyTrinh.${i}.s`}>{q.s}</div>
          <h3 data-edit={`t:quyTrinh.${i}.t`}>{q.t}</h3>
          <p data-edit={`t:quyTrinh.${i}.d`}>{q.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 9: GIÁ TRỊ LỚN -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secGiaTriLon.tag">{secGiaTriLon.tag}</span>
      <h2 class="sec-title" data-edit="t:secGiaTriLon.title">{secGiaTriLon.title}</h2>
    </div>
    <div class="grid4">
      {giaTriLon.map((g, i) => (
        <div class="pain">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <h3 data-edit={`t:giaTriLon.${i}.t`}>{g.t}</h3>
          <p data-edit={`t:giaTriLon.${i}.d`}>{g.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 10: XỬ LÝ TỪ CHỐI -->
<section>
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secObjections.tag">{secObjections.tag}</span>
      <h2 class="sec-title" data-edit="t:secObjections.title">{secObjections.title}</h2>
    </div>
    <div class="faq">
      {objections.map((f, i) => (
        <details>
          <summary data-edit={`t:objections.${i}.q`}>{f.q}</summary>
          <div class="ans" data-edit={`t:objections.${i}.a`}>{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 11: LÝ DO MUA (SỨ MỆNH) -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secTruCot.tag">{secTruCot.tag}</span>
      <h2 class="sec-title" data-edit="t:secTruCot.title">{secTruCot.title}</h2>
      <p style="color:var(--text-soft); margin:0" data-edit="t:secTruCot.intro">{secTruCot.intro}</p>
    </div>
    <div class="pillars">
      {truCot.map((p, i) => (
        <div class="pillar">
          <p class="big" data-edit={`t:truCot.${i}.t`}>{p.t}</p>
          <p data-edit={`t:truCot.${i}.d`}>{p.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BƯỚC 12: TẠO GIỚI HẠN -->
<section>
  <div class="wrap">
    <div class="scarcity">
      <div class="ic">!</div>
      <div>
        <h3 data-edit="t:gioiHan.title">{gioiHan.title}</h3>
        <p data-edit="t:gioiHan.body">{gioiHan.body}</p>
      </div>
    </div>
  </div>
</section>

<!-- BƯỚC 13: GIÁ TRỊ THẬT + BẢNG GIÁ -->
<section id="bang-gia" style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secBangGia.tag">{secBangGia.tag}</span>
      <h2 class="sec-title" data-edit="t:secBangGia.title">{secBangGia.title}</h2>
    </div>
    <p class="value-line">Cước một chuyến xe luôn <b>rẻ hơn nhiều</b> so với cái giá của một lô hàng tới trễ hay hư hỏng. Dưới đây là mức tham khảo để bạn dự trù chi phí — thuê <b>nguyên chuyến</b> từ TP.HCM đi các tỉnh, đơn vị: <b>triệu đồng / chuyến</b>.</p>
    <p class="swipe-hint">← vuốt ngang để xem đủ bảng →</p>
    <div class="price-wrap">
      <table class="price">
        <thead>
          <tr>
            <th>Tuyến (TP.HCM đi)</th>
            <th>Xe 8 tấn</th>
            <th>Xe 10 tấn</th>
            <th>Xe 15 tấn</th>
            <th>Xe 20 tấn</th>
            <th>Thời gian</th>
          </tr>
        </thead>
        <tbody>
          {bangGia.map((r, i) => (
            <tr>
              <td data-edit={`t:bangGia.${i}.vung`}>{r.vung}</td>
              <td class="money" data-edit={`t:bangGia.${i}.t8`}>{r.t8}</td>
              <td class="money" data-edit={`t:bangGia.${i}.t10`}>{r.t10}</td>
              <td class="money" data-edit={`t:bangGia.${i}.t15`}>{r.t15}</td>
              <td class="money" data-edit={`t:bangGia.${i}.t20`}>{r.t20}</td>
              <td class="tg" data-edit={`t:bangGia.${i}.tg`}>{r.tg}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="price-note">
      <b>Lưu ý:</b> Giá trên là mức tham khảo cho chuyến nguyên xe, <b>chưa gồm VAT 8%</b>, phí bốc xếp tận nơi và phí đường cấm (nếu có).
      Giá thực tế thay đổi theo loại hàng, thời điểm và tuyến cụ thể. <b>Xe cẩu và container 30 tấn</b> báo giá riêng.
      Gọi <a href={`tel:${TEL}`} class="tnum" style="color:var(--brand-dark);font-weight:800;text-decoration:none">{HOTLINE}</a> để nhận báo giá chính xác trong 30 phút.
    </p>
    <div class="price-cta"><a class="btn-call" href={`tel:${TEL}`}>📞 Nhận báo giá chính xác</a></div>
  </div>
</section>

<!-- BƯỚC 14: QUÀ TẶNG / CAM KẾT THÊM -->
<section>
  <div class="wrap">
    <div class="bonus">
      <span class="step-tag" style="background:rgba(255,255,255,.12); color:#ffd9c9" data-edit="t:secQuaTang.tag">{secQuaTang.tag}</span>
      <h2 class="sec-title" data-edit="t:secQuaTang.title">{secQuaTang.title}</h2>
      <ul>{quaTang.map((q, i) => (<li data-edit={`t:quaTang.${i}`}>{q}</li>))}</ul>
    </div>
  </div>
</section>

<!-- BƯỚC 15: TESTIMONIAL -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secDanhGia.tag">{secDanhGia.tag}</span>
      <h2 class="sec-title" data-edit="t:secDanhGia.title">{secDanhGia.title}</h2>
    </div>
    <div class="rev-grid">
      {danhGia.map((r, i) => (
        <div class="rev">
          <div class="stars">★★★★★</div>
          <p>“<span data-edit={`t:danhGia.${i}.noi`}>{r.noi}</span>”</p>
          <div class="who">
            <img src={r.avatar} data-edit-img={`t:danhGia.${i}.avatar`} alt={r.ten} width="46" height="46" loading="lazy">
            <div><b data-edit={`t:danhGia.${i}.ten`}>{r.ten}</b><br><small data-edit={`t:danhGia.${i}.chuc`}>{r.chuc}</small></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Blog / kinh nghiệm -->
{teaserPosts.length > 0 && (
<section id="kinh-nghiem">
  <div class="wrap">
    <div class="center">
      <span class="step-tag" data-edit="t:secBlog.tag">{secBlog.tag}</span>
      <h2 class="sec-title" data-edit="t:secBlog.title">{secBlog.title}</h2>
    </div>
    <div class="blog-grid">
      {teaserPosts.map((p) => (
        <div class="bcard">
          <p class="tag">Bài viết</p>
          <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
          <p>{p.data.description}</p>
          <a class="more" href={`/blog/${p.id}`}>Đọc tiếp →</a>
        </div>
      ))}
    </div>
    <div class="blog-all"><a href="/blog">Xem tất cả bài viết →</a></div>
  </div>
</section>
)}

<!-- BƯỚC 16: CTA CUỐI -->
<section style="background:var(--panel)">
  <div class="wrap">
    <div class="final">
      <h2 data-edit="t:ctaCuoi.title">{ctaCuoi.title}</h2>
      <p data-edit="t:ctaCuoi.body">{ctaCuoi.body}</p>
      <a class="btn-call" href={`tel:${TEL}`}>📞 Gọi ngay {HOTLINE}</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="site-foot">
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <b class="brand">{COMPANY_FULL}</b>
        <p>Vận tải tử tế — đúng giờ, đúng giá, có trách nhiệm. Đội xe hơn 100 chiếc, nhận chở nguyên chuyến và ghép hàng từ TP.HCM đi 63 tỉnh thành.</p>
        <div class="line">📍 {ADDRESS}</div>
        <div class="line">📞 <a href={`tel:${TEL}`} class="tnum">{HOTLINE}</a></div>
        <div class="line">🧾 MST: <span class="tnum">{MST}</span></div>
      </div>
      <div class="navcol">
        <h4>Dịch vụ</h4>
        {dichVu.slice(0, 6).map((d) => (<a href="#dich-vu">{d.ten}</a>))}
      </div>
      <div class="navcol">
        <h4>Liên kết nhanh</h4>
        <a href="/">Trang chủ</a>
        <a href="#bang-gia">Bảng giá</a>
        <a href="#khu-vuc">Khu vực phục vụ</a>
        <a href="#quy-trinh">Quy trình đặt xe</a>
        <a href="/blog">Blog kinh nghiệm</a>
      </div>
    </div>
    <div class="cr">
      <span>© 2026 {COMPANY_FULL}. All rights reserved.</span>
      <span>Vận tải tử tế — đúng giờ, đúng giá, có trách nhiệm.</span>
    </div>
  </div>
</footer>

{/* Form liên hệ tự nổi (chỉ hiện khi có mã nhúng ở /quan-ly > Cài đặt) */}
{CONTACT_FORM && (
  <Fragment>
    <div id="cf-pop" data-delay={CONTACT_FORM_DELAY} aria-hidden="true" style="position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:16px">
      <div data-cf-bg style="position:absolute;inset:0;background:rgba(10,37,64,.6)"></div>
      <div role="dialog" aria-modal="true" style="position:relative;background:#fff;border-radius:18px;max-width:460px;width:100%;max-height:88vh;overflow:auto;padding:26px 22px 22px;box-shadow:0 30px 70px rgba(0,0,0,.35)">
        <button data-cf-x aria-label="Đóng" style="position:absolute;top:10px;right:12px;width:34px;height:34px;border:0;border-radius:50%;background:#eef2fb;color:#111;font-size:22px;line-height:1;cursor:pointer">&times;</button>
        <h3 style="font-size:20px;font-weight:800;color:#0a2540;margin:0 0 12px;padding-right:30px">{CONTACT_FORM_TITLE}</h3>
        <div set:html={CONTACT_FORM} />
      </div>
    </div>
    <script is:inline set:html={`(function(){var p=document.getElementById('cf-pop');if(!p)return;var delay=(parseInt(p.getAttribute('data-delay'),10)||6)*1000;function runScripts(){p.querySelectorAll('script').forEach(function(s){var n=document.createElement('script');for(var i=0;i<s.attributes.length;i++){n.setAttribute(s.attributes[i].name,s.attributes[i].value);}if(!s.src)n.textContent=s.textContent;document.body.appendChild(n);s.remove();});}function open(){if(sessionStorage.getItem('cf_pop_seen'))return;p.style.display='flex';p.setAttribute('aria-hidden','false');sessionStorage.setItem('cf_pop_seen','1');try{runScripts();}catch(e){}}function close(){p.style.display='none';p.setAttribute('aria-hidden','true');}setTimeout(open,delay);var x=p.querySelector('[data-cf-x]'),bg=p.querySelector('[data-cf-bg]');if(x)x.addEventListener('click',close);if(bg)bg.addEventListener('click',close);document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});})();`} />
  </Fragment>
)}


</body>
</html>
