const TEL = '0839861499';

const dichVu = [
  { img: '/img/xe-8-tan.webp', ten: 'Xe Tải Chở Hàng 8 Tấn', bullets: ['Kích thước thùng: 7m và 9.5m', 'Thích hợp hàng công nghiệp vừa', 'Thùng bạt / kín bảo vệ an toàn'] },
  { img: '/img/xe-10-tan.webp', ten: 'Xe Tải Chở Hàng 10 Tấn', bullets: ['Kích thước thùng: 9.5m - 10m', 'Đáp ứng hàng cồng kềnh dài', 'Đa dạng loại thùng chuyên dụng'] },
  { img: '/img/xe-15-tan.webp', ten: 'Xe Tải Chở Hàng 15 Tấn', bullets: ['Tải trọng lớn, tiết kiệm chi phí', 'Chuyên chở nguyên chuyến', 'Vận chuyển đường dài an toàn'] },
  { img: '/img/xe-20-tan.webp', ten: 'Xe Tải 20 Tấn', bullets: ['Siêu trọng tải cho công trình', 'Thùng mui bạt và container', 'Phù hợp hàng hóa khối lượng lớn'] },
  { img: '/img/xe-cau.webp', ten: 'Xe Cẩu Hàng', bullets: ['Đa dạng tải trọng cẩu nâng', 'Xử lý máy móc, vật liệu nặng', 'Vận hành bởi đội ngũ chứng chỉ'] },
