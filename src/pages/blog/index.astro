---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import chung from '../../data/chung.json';

const now = Date.now();
const baiViet = (await getCollection('blog'))
  .filter((b) => b.data.ngayDang.valueOf() <= now)
  .sort((a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf());

// Ảnh đại diện: ưu tiên ảnh anh Nhận đặt cho bài (anhDaiDien, sửa ở /admin);
// bài chưa đặt thì xoay vòng ảnh xe marketing cho đỡ trùng nhau.
const ANH_MAC_DINH = ['/anh/xe-8-tan.webp', '/anh/xe-10-tan.webp', '/anh/xe-15-tan.webp', '/anh/xe-cau.webp', '/anh/xe-container.webp', '/anh/xe-20-tan.webp', '/img/doi-xe.webp'];
const anhBai = (bai, i) => bai.data.anhDaiDien || ANH_MAC_DINH[i % ANH_MAC_DINH.length];

// SEO: tiêu đề + mô tả + ảnh chia sẻ (đường dẫn đầy đủ) cho trang danh sách blog
const BLOG_TITLE = 'Blog Lê Chung — Kinh nghiệm thuê xe tải, chở hàng, vận chuyển';
const BLOG_DESC = 'Kinh nghiệm thuê xe tải chở hàng, chọn loại xe, đóng gói, tính cước, tránh phát sinh — viết bằng lời thường cho khách cần vận chuyển. Lê Chung 0839 861 499.';
const BLOG_URL = 'https://lechung.vn/blog/';
const ANH_CHIA_SE = new URL('/img/doi-xe.webp', Astro.site ?? 'https://lechung.vn').href;
// Favicon (icon nhỏ ở tab trình duyệt, sửa ở /quan-ly > Liên hệ) — để trống thì giữ y như cũ (favicon.svg + favicon.ico mặc định)
const FAVICON = ((chung as { favicon?: string }).favicon || '').trim();
const FAVICON_TYPE: Record<string, string> = { svg: 'image/svg+xml', png: 'image/png', webp: 'image/webp', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };
const FAVICON_MIME = FAVICON_TYPE[FAVICON.split('.').pop()?.toLowerCase() || ''] || 'image/png';
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{FAVICON ? <link rel="icon" type={FAVICON_MIME} href={FAVICON} /> : <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" /></>}
<title>{BLOG_TITLE}</title>
<meta name="description" content={BLOG_DESC}>
<link rel="canonical" href={BLOG_URL}>
<meta property="og:title" content={BLOG_TITLE}>
<meta property="og:description" content={BLOG_DESC}>
<meta property="og:type" content="website">
<meta property="og:url" content={BLOG_URL}>
<meta property="og:image" content={ANH_CHIA_SE}>
<meta property="og:site_name" content="Vận Tải Lê Chung">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={BLOG_TITLE}>
<meta name="twitter:description" content={BLOG_DESC}>
<meta name="twitter:image" content={ANH_CHIA_SE}>
<style is:global>
  :root{
    --bg:#ffffff; --panel:#f7f9fc; --card:#ffffff; --line:#e6ebf3;
    --text:#111214; --text-soft:#3a3f45; --muted:#6b7280;
    --brand:#ff6b35; --brand-dark:#e5541f; --brand-tint:#fff1ea;
    --navy:#0a2540; --navy-2:#15324d;
    --shadow:0 1px 2px rgba(10,37,64,.06),0 8px 30px rgba(10,37,64,.08);
    --radius:14px;
  }
  /* Nền TRẮNG cho MỌI người — anh Nhận chọn (đã bỏ chế độ tối theo máy). */
  *{box-sizing:border-box}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif; line-height:1.6; -webkit-font-smoothing:antialiased}
  .wrap{max-width:1120px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  .tnum{font-variant-numeric:tabular-nums}
  /* Header dùng chung: xem src/components/Header.astro */
  .head-sec{max-width:680px; margin:0 auto; text-align:center; padding:40px 0 8px}
  .head-sec h1{font-size:clamp(26px,4vw,38px); font-weight:800; letter-spacing:-.015em; margin:0 0 10px; text-wrap:balance}
  .head-sec p{margin:0; color:var(--muted); font-size:16px}
  section{padding:30px 0 44px}
  .blog-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:16px}
  @media(max-width:960px){ .blog-grid{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:600px){ .blog-grid{grid-template-columns:1fr} }
  .bcard{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:20px; box-shadow:var(--shadow); display:flex; flex-direction:column; overflow:hidden}
  .bcard .thumb{display:block; margin:-20px -20px 14px; aspect-ratio:16/9; overflow:hidden; background:var(--panel)}
  .bcard .thumb img{width:100%; height:100%; object-fit:cover; display:block; transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  @media(hover:hover){ .bcard:hover .thumb img{transform:scale(1.06)} }
  .bcard h3{margin:0 0 8px; font-size:16px; font-weight:800; line-height:1.35}
  .bcard h3 a{text-decoration:none}
  .bcard h3 a:hover{color:var(--brand-dark)}
  .bcard p{margin:0 0 14px; color:var(--text-soft); font-size:13.8px; flex:1}
  .bcard .more{color:var(--brand-dark); font-weight:800; font-size:14px; text-decoration:none}
  .bcard .more:hover{text-decoration:underline}
  .cta-box{background:linear-gradient(160deg,var(--navy),var(--navy-2)); color:#fff; border-radius:18px; padding:30px 26px; text-align:center; margin:10px 0 40px}
  .cta-box h3{margin:0 0 8px; font-size:21px; font-weight:800}
  .cta-box p{margin:0 0 16px; color:#c7d3e2; font-size:15px}
  .cta-box a.go{display:inline-block; background:var(--brand); color:#fff; text-decoration:none; font-weight:800; font-size:16.5px; padding:13px 26px; border-radius:11px; box-shadow:0 8px 24px rgba(255,107,53,.35)}
  .cta-box a.go:hover{background:var(--brand-dark)}
  .site-foot{border-top:1px solid var(--line); background:var(--panel); padding:22px 0 32px; text-align:center; color:var(--muted); font-size:13px}
  .site-foot b{color:var(--text-soft)}
  .site-foot a{color:var(--text-soft)}
  .empty{text-align:center; color:var(--muted); padding:40px 0}
</style>
</head>
<body>

<Header />

<div class="wrap">
  <div class="head-sec">
    <h1>Blog Lê Chung</h1>
    <p>Kinh nghiệm thuê xe tải, chở hàng, vận chuyển — viết bằng lời thường, đọc xong đỡ lo phát sinh.</p>
  </div>

  <section>
    {baiViet.length === 0 && <div class="empty">Chưa có bài viết nào.</div>}
    <div class="blog-grid">
      {baiViet.map((bai, i) => (
        <div class="bcard">
          <a class="thumb" href={`/blog/${bai.id}`}><img src={anhBai(bai, i)} alt={bai.data.title} loading="lazy" width="360" height="203"></a>
          <h3><a href={`/blog/${bai.id}`}>{bai.data.title}</a></h3>
          <p>{bai.data.description}</p>
          <a class="more" href={`/blog/${bai.id}`}>Đọc tiếp →</a>
        </div>
      ))}
    </div>
  </section>

  <div class="cta-box">
    <h3>Cần thuê xe tải chở hàng ngay?</h3>
    <p>Gọi Lê Chung — tư vấn loại xe, báo giá nhanh, có xe trong ngày.</p>
    <a class="go" href="tel:0839861499">📞 Gọi ngay 0839 861 499</a>
  </div>
</div>

<footer class="site-foot">
  <div class="wrap">
    <b>LÊ CHUNG</b> · Dịch vụ xe tải chở hàng · Hotline: <span class="tnum">0839 861 499</span><br>
    © 2026 <b>lechung.vn</b> · <a href="/">Trang chủ</a> · <a href="/blog">Blog</a>
  </div>
</footer>
</body>
</html>
