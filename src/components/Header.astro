---
// Menu dùng chung cho các trang Blog (danh sách + bài viết).
// Trỏ về đúng mục ở trang chủ (/#...) và các bài khu vực. Menu xổ + hamburger giống trang chủ.
import { getCollection } from 'astro:content';
import chung from '../data/chung.json';

const HOTLINE = chung.hotline;
const TEL = chung.tel;
const ZALO = chung.zalo;
const LOGO = chung.logo;
const MESSENGER = String((chung as { messenger?: string }).messenger || '').trim();
// Mã Facebook Pixel (anh Nhận dán ở /admin để chạy quảng cáo). Chỉ lấy chữ số cho an toàn; trống => KHÔNG gắn gì.
const FB_PIXEL = String(chung.fbPixel || '').replace(/[^0-9]/g, '');

const posts = (await getCollection('blog'))
  .filter((p) => p.data.ngayDang.valueOf() <= Date.now())
  .sort((a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf());
const norm = (s) => (s || '').toLowerCase();
function findId(keywords) {
  for (const kw of keywords) {
    const hit = posts.find((p) => norm(p.data.title + ' ' + p.data.description).includes(kw.toLowerCase()));
    if (hit) return hit.id;
  }
  return null;
}
function areaHref(a) {
  if (posts.find((p) => p.id === a.slug)) return '/blog/' + a.slug;
  const id = findId(a.kw);
  return id ? '/blog/' + id : '/#khu-vuc';
}
const dichVuTen = ['Xe Tải Chở Hàng 8 Tấn', 'Xe Tải Chở Hàng 10 Tấn', 'Xe Tải Chở Hàng 15 Tấn', 'Xe Tải 20 Tấn', 'Xe Cẩu Hàng', 'Xe Container / Đầu Kéo'];
const khuVuc = [
  { ten: 'TP. Hồ Chí Minh', slug: 'van-chuyen-hang-hoa-noi-thanh-tphcm', kw: ['nội thành', 'tphcm', 'hồ chí minh', 'sài gòn'] },
  { ten: 'Miền Đông Nam Bộ', slug: 'van-chuyen-hang-di-mien-dong-nam-bo', kw: ['miền đông', 'đồng nai', 'bình dương', 'vũng tàu'] },
  { ten: 'Miền Tây Nam Bộ', slug: 'van-chuyen-hang-di-mien-tay', kw: ['miền tây', 'cần thơ', 'long an', 'tiền giang'] },
  { ten: 'Tây Nguyên', slug: 'van-chuyen-hang-di-tay-nguyen', kw: ['tây nguyên', 'đắk lắk', 'gia lai', 'lâm đồng', 'pleiku'] },
  { ten: 'Miền Trung', slug: 'van-chuyen-hang-di-mien-trung', kw: ['miền trung', 'đà nẵng', 'huế', 'quy nhơn', 'nha trang'] },
  { ten: 'Miền Bắc', slug: 'van-chuyen-hang-di-mien-bac', kw: ['miền bắc', 'hà nội', 'hải phòng'] },
];
---
<!-- Bật hiệu ứng cuộn-hiện. Class này do JS thêm; nếu tắt JS thì KHÔNG có class -> nội dung hiện đầy đủ (an toàn). -->
<script is:inline>document.documentElement.classList.add('reveal-on');</script>

{FB_PIXEL && (
  <Fragment>
    <script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${FB_PIXEL}');fbq('track','PageView');`} />
    <noscript set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${FB_PIXEL}&ev=PageView&noscript=1" alt="" />`} />
  </Fragment>
)}

<header class="site-head">
  <div class="wrap">
    <div class="bar">
      <a class="brand-logo" href="/"><img src={LOGO} alt="Vận Tải Lê Chung" width="150" height="44"></a>
      <nav class="nav-links" id="mainnav">
        <button class="nav-close" id="navClose" aria-label="Đóng menu">✕</button>
        <a href="/">Trang chủ</a>
        <a href="/#gioi-thieu">Giới thiệu</a>

        <div class="nav-item">
          <a href="/#dich-vu" class="nav-top">Dịch vụ <span class="caret">▾</span></a>
          <div class="submenu">
            {dichVuTen.map((t) => (<a href="/#dich-vu">{t}</a>))}
          </div>
        </div>

        <a href="/#quy-trinh">Quy trình</a>

        <div class="nav-item">
          <a href="/#bang-gia" class="nav-top">Bảng giá <span class="caret">▾</span></a>
          <div class="submenu">
            <a href="/#bang-gia">Giá thuê xe đi tỉnh (nguyên chuyến)</a>
            <a href="/#bang-gia">Xe chở hàng nội thành TP.HCM</a>
            <a href="/#bang-gia">Cách tính cước &amp; lưu ý</a>
          </div>
        </div>

        <div class="nav-item">
          <a href="/#khu-vuc" class="nav-top">Khu vực <span class="caret">▾</span></a>
          <div class="submenu">
            {khuVuc.map((k) => (<a href={areaHref(k)}>{k.ten}</a>))}
          </div>
        </div>

        <a href="/#kinh-nghiem">Kinh nghiệm</a>

        <a class="btn" href={`tel:${TEL}`}>📞 {HOTLINE}</a>
      </nav>
      <div class="nav-overlay" id="navOverlay"></div>
      <button class="hamb" id="hamb" aria-label="Mở menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<!-- Nút liên hệ nổi (hiện trên mọi trang) -->
<div class="fab">
  <a class="call" href={`tel:${TEL}`} aria-label={`Gọi ngay ${HOTLINE}`}>
    <span class="lbl">Gọi ngay</span>
    <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2Z"/></svg></span>
  </a>
  <a class="zalo" href={`https://zalo.me/${ZALO}`} target="_blank" rel="noopener" aria-label="Chat Zalo">
    <span class="lbl">Chat Zalo</span>
    <span class="ic"><span class="zalo-mark">Zalo</span></span>
  </a>
  {MESSENGER && (
    <a class="msg" href={MESSENGER} target="_blank" rel="noopener" aria-label="Nhắn Messenger">
      <span class="lbl">Messenger</span>
      <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M12 2C6.48 2 2 6.15 2 11.27c0 2.91 1.44 5.51 3.7 7.21V22l3.38-1.86c.9.25 1.87.38 2.92.38 5.52 0 10-4.15 10-9.27S17.52 2 12 2Zm1.01 12.48-2.55-2.72-4.98 2.72 5.48-5.82 2.61 2.72 4.9-2.72-5.46 5.82Z"/></svg></span>
    </a>
  )}
</div>

<button id="backtop" class="backtop" aria-label="Về đầu trang">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="m18 15-6-6-6 6"/></svg>
</button>

<!-- Popup "khách vừa liên hệ" — nội dung MÔ PHỎNG để tạo niềm tin -->
<div class="socialpop" id="socialpop" aria-hidden="true">
  <div class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M20 6 9 17l-5-5"/></svg></div>
  <div class="txt" id="socialpop-txt"></div>
</div>

<style>
  /* position:sticky bị hỏng vì html/body có overflow-x:hidden/clip (chặn cuộn ngang cho hiệu ứng
     cuộn-hiện) — overflow khác visible trên tổ tiên làm sticky mất tác dụng. Dùng position:fixed
     thay thế (không bị ảnh hưởng bởi overflow của tổ tiên) + chừa khoảng trống bằng padding-top. */
  html{ scroll-padding-top:var(--header-h,64px); }
  body{ padding-top:var(--header-h,64px); }
  .site-head{position:fixed; top:0; left:0; right:0; z-index:60; background:rgba(247,249,252,.92); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border-bottom:1px solid var(--line); transition:box-shadow .25s ease}
  .site-head.scrolled{box-shadow:0 6px 24px rgba(5,8,12,.08)}
  .site-head .bar{display:flex; align-items:center; justify-content:space-between; gap:16px; padding:10px 0}
  .brand-logo{display:flex; align-items:center; gap:10px; text-decoration:none}
  .brand-logo img{height:44px; width:auto}
  .nav-links{display:flex; align-items:center; gap:4px; font-size:14.5px; font-weight:700}
  .nav-links > a,
  .nav-top{display:inline-flex; align-items:center; gap:5px; text-decoration:none; color:var(--text-soft); padding:9px 12px; border-radius:9px; white-space:nowrap}
  .nav-links > a:hover,
  .nav-top:hover{color:var(--brand-dark); background:var(--brand-tint)}
  .nav-item{position:relative}
  .caret{font-size:10px; transition:transform .18s ease; opacity:.8}
  .nav-item:hover .caret,
  .nav-item:focus-within .caret{transform:rotate(180deg)}
  .submenu{
    position:absolute; top:calc(100% + 6px); left:0; min-width:230px;
    background:var(--panel); border:1px solid var(--line); border-radius:12px;
    box-shadow:var(--shadow); padding:8px; display:flex; flex-direction:column; gap:2px;
    opacity:0; visibility:hidden; transform:translateY(8px); transition:opacity .16s ease, transform .16s ease, visibility .16s;
    z-index:70;
  }
  .nav-item:hover .submenu,
  .nav-item:focus-within .submenu{opacity:1; visibility:visible; transform:translateY(0)}
  .submenu::before{content:''; position:absolute; top:-8px; left:0; right:0; height:8px}
  .submenu a{display:block; text-decoration:none; color:var(--text-soft); font-weight:700; font-size:14px; padding:9px 12px; border-radius:8px; line-height:1.35}
  .submenu a:hover{background:var(--brand-tint); color:var(--brand-dark)}
  .submenu a.all{color:var(--brand-dark); border-top:1px solid var(--line); margin-top:4px; padding-top:11px; border-radius:0 0 8px 8px}
  .nav-links a.btn{background:linear-gradient(160deg,var(--brand),var(--brand-dark)); color:#fff; padding:9px 16px; border-radius:10px; display:inline-flex; gap:6px; align-items:center; margin-left:6px; box-shadow:0 6px 16px rgba(223,77,28,.28); transition:transform .2s ease, box-shadow .2s ease}
  .nav-links a.btn:hover{filter:brightness(1.05); transform:translateY(-1px); box-shadow:0 10px 22px rgba(223,77,28,.36)}
  .hamb{display:none; background:transparent; border:1px solid var(--line); color:var(--text); width:44px; height:42px; border-radius:10px; font-size:22px; line-height:1; cursor:pointer; align-items:center; justify-content:center}
  .hamb:hover{background:var(--brand-tint); color:var(--brand-dark)}

  /* Ngăn kéo menu di động (kiểu Danh Long): trượt từ bên phải + nền che mờ phía sau */
  .nav-close{display:none}
  .nav-overlay{display:none}
  @media(max-width:920px){
    .hamb{display:inline-flex}
    .nav-overlay{
      display:block; position:fixed; inset:0; z-index:95; background:rgba(7,13,20,.55);
      opacity:0; visibility:hidden; transition:opacity .25s ease, visibility .25s;
    }
    .nav-overlay.open{opacity:1; visibility:visible}
    .nav-links{
      position:fixed; top:0; right:0; bottom:0; width:min(320px,84vw); z-index:96;
      background:var(--panel); box-shadow:-14px 0 40px rgba(7,13,20,.28);
      flex-direction:column; align-items:stretch; gap:2px; padding:64px 16px 24px;
      transform:translateX(100%); transition:transform .3s cubic-bezier(.2,.8,.2,1);
      overflow-y:auto; display:flex;
    }
    .nav-links.open{transform:translateX(0)}
    .nav-close{
      display:flex; position:absolute; top:14px; right:14px; width:38px; height:38px;
      border-radius:10px; border:1px solid var(--line); background:var(--card); color:var(--text);
      align-items:center; justify-content:center; font-size:18px; cursor:pointer;
    }
    .nav-close:hover{background:var(--brand-tint); color:var(--brand-dark)}
    .nav-links > a,
    .nav-top{padding:11px 12px; font-size:15.5px}
    .nav-item{position:static}
    .nav-item .caret{display:none}
    .submenu{
      position:static; opacity:1; visibility:visible; transform:none; box-shadow:none;
      border:0; border-left:2px solid var(--line); border-radius:0; margin:0 0 4px 12px;
      padding:0 0 0 8px; min-width:0;
    }
    .submenu a.all{border-top:0}
    .nav-links a.btn{justify-content:center; margin:8px 0 0; padding:12px}
  }

  /* NÚT LIÊN HỆ NỔI + HIỆU ỨNG NHẤP NHÁY */
  .fab{position:fixed; right:16px; bottom:18px; z-index:90; display:flex; flex-direction:column; gap:14px; align-items:flex-end}
  .fab a{display:inline-flex; align-items:center; gap:10px; text-decoration:none}
  .fab .lbl{background:var(--panel); color:var(--text); font-weight:800; font-size:13px; padding:8px 13px; border-radius:999px; box-shadow:var(--shadow); white-space:nowrap; border:1px solid var(--line)}
  .fab .ic{position:relative; width:54px; height:54px; border-radius:50%; display:grid; place-items:center; color:#fff; flex:0 0 auto; box-shadow:0 6px 18px rgba(0,0,0,.3); animation:fab-bob 2.4s ease-in-out infinite}
  .fab .call .ic{background:#16a34a; --ring:22,163,74}
  .fab .zalo .ic{background:#0068ff; --ring:0,104,255}
  .fab .msg .ic{background:#0a7cff; --ring:10,124,255}
  .fab .zalo-mark{font-weight:900; font-size:14px; letter-spacing:-.02em}
  .fab .ic::after{content:''; position:absolute; inset:0; border-radius:50%; animation:fab-ring 1.7s ease-out infinite}
  @keyframes fab-ring{ 0%{box-shadow:0 0 0 0 rgba(var(--ring),.5)} 100%{box-shadow:0 0 0 16px rgba(var(--ring),0)} }
  @keyframes fab-bob{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
  .fab a:hover .ic{filter:brightness(1.08)}
  @media(max-width:560px){ .fab{right:12px; bottom:14px; gap:12px} .fab .lbl{display:none} .fab .ic{width:52px; height:52px} }
  @media(prefers-reduced-motion:reduce){ .fab .ic, .fab .ic::after{animation:none} }

  /* Nút về đầu trang — hiện khi cuộn xuống */
  .backtop{
    position:fixed; left:16px; bottom:18px; z-index:90; width:44px; height:44px; border-radius:50%;
    background:var(--text); color:#fff; border:0; display:grid; place-items:center; cursor:pointer;
    box-shadow:var(--shadow); opacity:0; visibility:hidden; transform:translateY(10px);
    transition:opacity .25s ease, transform .25s ease, visibility .25s;
  }
  .backtop.show{opacity:1; visibility:visible; transform:none}
  .backtop:hover{background:var(--brand-dark)}
  @media(max-width:560px){ .backtop{left:12px; bottom:14px; width:40px; height:40px} }

  /* POPUP "KHÁCH VỪA LIÊN HỆ" (mô phỏng) */
  .socialpop{position:fixed; left:16px; bottom:18px; z-index:88; max-width:300px; background:var(--panel); border:1px solid var(--line); border-radius:14px; box-shadow:0 12px 32px rgba(0,0,0,.2); padding:12px 14px; display:flex; gap:11px; align-items:center; transform:translateY(160%); opacity:0; transition:transform .45s cubic-bezier(.2,.8,.2,1), opacity .45s ease; pointer-events:none}
  .socialpop.show{transform:translateY(0); opacity:1}
  .socialpop .av{width:38px; height:38px; border-radius:50%; background:var(--brand-tint); color:var(--brand-dark); display:grid; place-items:center; flex:0 0 auto}
  .socialpop .txt{font-size:13px; color:var(--text-soft); line-height:1.35}
  .socialpop .txt b{color:var(--text)}
  .socialpop .txt .ago{color:var(--muted); font-size:11.5px}
  @media(max-width:560px){ .socialpop{left:10px; right:76px; max-width:none; bottom:14px} }
</style>

<style is:global>
  /* ===== HIỆU ỨNG CUỘN-HIỆN (đổ 2 bên vào) + RÊ CHUỘT ẢNH NỔI RA =====
     Trạng thái ẩn CHỈ áp dụng khi <html class="reveal-on"> (do JS thêm).
     Tắt JS  ->  không có class  ->  nội dung HIỆN ĐẦY ĐỦ (không bao giờ mất chữ). */
  html.reveal-on{ overflow-x:clip; }

  html.reveal-on :is(
    .center,.head-sec,.pain,.adv,.svc,.step,.pillar,.scarcity,
    .price-wrap,.value-line,.bonus,.emotion,.rev,.bcard,.final,
    .ba .col,.art h2,.art h3,.art figure,.art blockquote,.cta-box
  ){
    opacity:0;
    transform:translateY(34px);
    transition:opacity 1.1s ease, transform 1.35s cubic-bezier(.16,.72,.28,1);
    will-change:opacity, transform;
  }

  /* ĐỔ TỪ 2 BÊN: trong lưới, thẻ lẻ vào từ trái, thẻ chẵn vào từ phải */
  html.reveal-on .grid4 > .pain:nth-child(odd),
  html.reveal-on .adv-grid > .adv:nth-child(odd),
  html.reveal-on .svc-grid > .svc:nth-child(odd),
  html.reveal-on .pillars > .pillar:nth-child(odd),
  html.reveal-on .rev-grid > .rev:nth-child(odd),
  html.reveal-on .blog-grid > .bcard:nth-child(odd){ transform:translateX(-54px); }
  html.reveal-on .grid4 > .pain:nth-child(even),
  html.reveal-on .adv-grid > .adv:nth-child(even),
  html.reveal-on .svc-grid > .svc:nth-child(even),
  html.reveal-on .pillars > .pillar:nth-child(even),
  html.reveal-on .rev-grid > .rev:nth-child(even),
  html.reveal-on .blog-grid > .bcard:nth-child(even){ transform:translateX(54px); }
  /* Cặp "Trước / Sau": cột trái vào từ trái, cột phải vào từ phải */
  html.reveal-on .ba .col.before{ transform:translateX(-54px); }
  html.reveal-on .ba .col.after{ transform:translateX(54px); }

  /* Khi lọt vào tầm nhìn -> trượt về đúng chỗ, hiện rõ */
  html.reveal-on .is-in{ opacity:1 !important; transform:none !important; }

  /* Điện thoại: đổ nhẹ hơn để không tràn ngang */
  @media(max-width:600px){
    html.reveal-on .grid4 > *:nth-child(odd),
    html.reveal-on .adv-grid > *:nth-child(odd),
    html.reveal-on .svc-grid > *:nth-child(odd),
    html.reveal-on .pillars > *:nth-child(odd),
    html.reveal-on .rev-grid > *:nth-child(odd),
    html.reveal-on .blog-grid > *:nth-child(odd),
    html.reveal-on .ba .col.before{ transform:translateX(-28px); }
    html.reveal-on .grid4 > *:nth-child(even),
    html.reveal-on .adv-grid > *:nth-child(even),
    html.reveal-on .svc-grid > *:nth-child(even),
    html.reveal-on .pillars > *:nth-child(even),
    html.reveal-on .rev-grid > *:nth-child(even),
    html.reveal-on .blog-grid > *:nth-child(even),
    html.reveal-on .ba .col.after{ transform:translateX(28px); }
  }

  /* ===== RÊ CHUỘT VÀO ẢNH -> ẢNH NỔI/PHÓNG RA (chỉ trên máy có chuột) ===== */
  @media(hover:hover){
    .svc{ transition:transform .45s ease, box-shadow .45s ease; }
    .svc img{ transition:transform .85s cubic-bezier(.2,.7,.2,1); }
    .svc:hover{ box-shadow:0 20px 46px rgba(10,37,64,.20); }
    .svc:hover img{ transform:scale(1.08); }

    .hero-photo{ transition:transform .85s cubic-bezier(.2,.7,.2,1), box-shadow .6s ease; }
    .hero-photo:hover{ transform:scale(1.045) translateY(-6px); box-shadow:0 30px 64px rgba(0,0,0,.5); }

    .bcard{ transition:box-shadow .45s ease; }
    .bcard:hover{ box-shadow:0 20px 46px rgba(10,37,64,.18); }

    .art img{ transition:transform .7s ease, box-shadow .5s ease; }
    .art img:hover{ transform:scale(1.03); box-shadow:0 18px 44px rgba(10,37,64,.24); }

    .rev .who img{ transition:transform .55s ease; }
    .rev:hover .who img{ transform:scale(1.08); }
  }
  /* Anh Nhận chọn: LUÔN chạy hiệu ứng cho mọi người (không tắt theo cài đặt giảm-chuyển-động của máy). */
</style>

<script>
  // Header giờ position:fixed (xem lý do ở CSS .site-head) -> đo chiều cao thật, gán biến --header-h
  // để body chừa đúng khoảng trống, không bị banner/nội dung chui lên dưới thanh menu.
  (function () {
    var head = document.querySelector('.site-head');
    if (!head) return;
    function setH() { document.documentElement.style.setProperty('--header-h', head.offsetHeight + 'px'); }
    setH();
    window.addEventListener('resize', setH);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setH);
  })();
</script>

<script>
  // Cuộn xuống một chút -> header nổi bóng nhẹ cho có chiều sâu; cuộn sâu hơn -> hiện nút về đầu trang
  (function () {
    var head = document.querySelector('.site-head');
    var backtop = document.getElementById('backtop');
    function onScroll() {
      if (head) head.classList.toggle('scrolled', window.scrollY > 8);
      if (backtop) backtop.classList.toggle('show', window.scrollY > 500);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    if (backtop) backtop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  })();

  // Menu điện thoại: bấm ☰ để mở ngăn kéo, bấm ✕/nền mờ/link để đóng
  (function () {
    var hamb = document.getElementById('hamb');
    var nav = document.getElementById('mainnav');
    var overlay = document.getElementById('navOverlay');
    var closeBtn = document.getElementById('navClose');
    if (!hamb || !nav) return;
    function setOpen(open) {
      nav.classList.toggle('open', open);
      if (overlay) overlay.classList.toggle('open', open);
      hamb.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    hamb.addEventListener('click', function () { setOpen(!nav.classList.contains('open')); });
    if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); });
    if (overlay) overlay.addEventListener('click', function () { setOpen(false); });
    nav.addEventListener('click', function (e) {
      var a = e.target.closest('a');
      if (!a) return;
      if (a.classList.contains('nav-top')) return; // mục cha: để mở menu con
      setOpen(false);
    });
  })();

  // Popup "khách vừa liên hệ" — nội dung MÔ PHỎNG (không phải dữ liệu thật)
  (function () {
    var pop = document.getElementById('socialpop');
    var txt = document.getElementById('socialpop-txt');
    if (!pop || !txt) return;
    var areas = ['Bình Tân', 'Quận 7', 'Bình Chánh', 'Thủ Đức', 'Quận 12', 'Hóc Môn', 'Tân Bình', 'Gò Vấp', 'Nhà Bè', 'Củ Chi'];
    var acts = ['vừa gọi đặt xe tải', 'vừa liên hệ Zalo báo giá', 'vừa đặt chuyến đi tỉnh', 'vừa hỏi giá thuê xe'];
    function rnd(a) { return a[Math.floor(Math.random() * a.length)]; }
    function showOne() {
      var mins = 2 + Math.floor(Math.random() * 18);
      txt.innerHTML = '<b>Một khách ở ' + rnd(areas) + '</b> ' + rnd(acts) + '<br><span class="ago">' + mins + ' phút trước</span>';
      pop.classList.add('show');
      setTimeout(function () { pop.classList.remove('show'); }, 5000);
    }
    setTimeout(function () { showOne(); setInterval(showOne, 13000); }, 4000);
  })();
</script>

<script is:inline>
  // Cuộn tới đâu, nội dung đổ vào tới đó. Một lần cho mỗi phần.
  (function () {
    function start() {
      var sel = '.center,.head-sec,.pain,.adv,.svc,.step,.pillar,.scarcity,'
        + '.price-wrap,.value-line,.bonus,.emotion,.rev,.bcard,.final,'
        + '.ba .col,.art h2,.art h3,.art figure,.art blockquote,.cta-box,'
        + '.card,.stat,.qb-item,'
        + '.intro-txt,.intro-media,.cta-mid,.faq,.chips';
      var els = document.querySelectorAll(sel);
      // Không hỗ trợ theo dõi cuộn -> bỏ trạng thái ẩn, hiện hết cho chắc.
      if (!('IntersectionObserver' in window) || !els.length) {
        document.documentElement.classList.remove('reveal-on');
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      els.forEach(function (el) { io.observe(el); });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else { start(); }
  })();
</script>
