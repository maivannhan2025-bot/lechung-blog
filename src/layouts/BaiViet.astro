---
// Layout cho từng bài viết blog Lê Chung — giữ nguyên thương hiệu lechung.vn
import Header from '../components/Header.astro';
import chung from '../data/chung.json';
const { frontmatter } = Astro.props;
const { title, description, ngayDang, thoiGianDoc, anhDaiDien } = frontmatter;
// Ảnh đại diện đầu bài: ưu tiên ảnh anh Nhận đặt (anhDaiDien ở /admin), chưa có thì dùng ảnh đội xe.
const ANH_DAI_DIEN = anhDaiDien || '/img/doi-xe.webp';

// ==== SEO: đường dẫn + ảnh chia sẻ + Schema (Bài viết + Breadcrumb) cho Google, Zalo, Facebook ====
// (chỉ cộng thêm — không đổi giao diện bài viết)
const siteUrl = Astro.site ?? new URL('https://lechung.vn/');
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const postUrl = siteUrl.href.replace(/\/$/, '') + '/blog/' + slug + '/';
const anhChiaSe = new URL(ANH_DAI_DIEN, siteUrl).href;           // ảnh khi gửi link (phải là đường dẫn đầy đủ)
const logoUrl = new URL(chung.logo || '/favicon.svg', siteUrl).href;
const ngayISO = ngayDang ? new Date(ngayDang).toISOString() : undefined;
const congTy = (chung as { companyFull?: string }).companyFull || 'CÔNG TY TNHH DỊCH VỤ VẬN TẢI LÊ CHUNG';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: anhChiaSe,
  ...(ngayISO ? { datePublished: ngayISO, dateModified: ngayISO } : {}),
  author: { '@type': 'Organization', name: congTy },
  publisher: { '@type': 'Organization', name: congTy, logo: { '@type': 'ImageObject', url: logoUrl } },
  mainEntityOfPage: postUrl,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: siteUrl.href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: siteUrl.href.replace(/\/$/, '') + '/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} — Blog Lê Chung</title>
<meta name="description" content={description}>
<link rel="canonical" href={postUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="article">
<meta property="og:url" content={postUrl}>
<meta property="og:image" content={anhChiaSe}>
<meta property="og:site_name" content="Vận Tải Lê Chung">
{ngayISO && <meta property="article:published_time" content={ngayISO} />}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={anhChiaSe}>
<style is:global>
  :root{
    --bg:#ffffff; --panel:#f7f9fc; --card:#ffffff; --line:#e6ebf3;
    --text:#111214; --text-soft:#3a3f45; --muted:#6b7280;
    --brand:#ff6b35; --brand-dark:#e5541f; --brand-tint:#fff1ea;
    --navy:#0a2540; --navy-2:#15324d;
    --good:#12833f; --good-tint:#e9f7ee;
    --shadow:0 1px 2px rgba(10,37,64,.06),0 8px 30px rgba(10,37,64,.08);
    --radius:14px;
  }
  /* Nền TRẮNG cho MỌI người — anh Nhận chọn (đã bỏ chế độ tối theo máy). */
  *{box-sizing:border-box}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif; line-height:1.7; -webkit-font-smoothing:antialiased}
  .wrap{max-width:1120px; margin:0 auto; padding:0 20px}
  a{color:inherit}
  .tnum{font-variant-numeric:tabular-nums}
  /* Header dùng chung: xem src/components/Header.astro */
  @media(max-width:600px){
    .art table{display:block; overflow-x:auto; -webkit-overflow-scrolling:touch}
    .art p,.art li{overflow-wrap:break-word}
  }
  .art{max-width:760px; margin:0 auto; padding:34px 0 10px}
  .crumb{font-size:14px; font-weight:700}
  .crumb a{color:var(--brand-dark); text-decoration:none}
  .crumb a:hover{text-decoration:underline}
  h1{font-size:clamp(25px,4vw,36px); line-height:1.2; font-weight:800; letter-spacing:-.015em; margin:.5em 0 .3em; text-wrap:balance}
  .meta{color:var(--muted); font-size:13.5px; margin-bottom:18px}
  .art .bai-anh{width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:14px; margin:6px 0 26px; border:1px solid var(--line); box-shadow:var(--shadow); display:block}
  .art h2{font-size:clamp(19px,2.8vw,24px); font-weight:800; margin:1.6em 0 .5em; letter-spacing:-.01em}
  .art h3{font-size:clamp(17px,2.4vw,20px); font-weight:800; margin:1.3em 0 .4em}
  .art p{margin:0 0 1em; color:var(--text-soft); font-size:16px}
  .art strong, .art b{color:var(--text)}
  .art ul,.art ol{color:var(--text-soft); font-size:16px; padding-left:24px; margin:0 0 1em}
  .art li{margin-bottom:6px}
  .art blockquote{background:var(--card); border:1px solid var(--line); border-left:4px solid var(--brand); border-radius:10px; padding:16px 18px; margin:0 0 1em; color:var(--text-soft); font-size:15px; box-shadow:var(--shadow)}
  .art blockquote p{margin:0}
  .art img{max-width:100%; height:auto; border-radius:12px; margin:1em 0}
  .art table{border-collapse:collapse; width:100%; margin:0 0 1em; background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:hidden; font-size:14.5px}
  .art th,.art td{padding:10px 12px; border-bottom:1px solid var(--line); text-align:left; color:var(--text-soft)}
  .art th{color:var(--text); font-weight:800; font-size:13.5px}
  .art td.r,.art th.r{text-align:right}
  .art figure{margin:0 0 1.3em}
  .art figure img{width:100%; height:auto; display:block; border-radius:12px; border:1px solid var(--line); box-shadow:var(--shadow); margin:0}
  .art figcaption{color:var(--muted); font-size:13px; text-align:center; margin-top:8px}
  .art a{color:var(--brand-dark); font-weight:600}
  .cta-box{background:linear-gradient(160deg,var(--navy),var(--navy-2)); color:#fff; border-radius:18px; padding:28px 26px; text-align:center; margin:34px 0 10px}
  .cta-box h3{margin:0 0 8px; font-size:21px; font-weight:800; color:#fff}
  .cta-box p{margin:0 0 16px; color:#c7d3e2; font-size:15px}
  .cta-box a.go{display:inline-block; background:var(--brand); color:#fff; text-decoration:none; font-weight:800; font-size:16.5px; padding:13px 26px; border-radius:11px; box-shadow:0 8px 24px rgba(255,107,53,.35)}
  .cta-box a.go:hover{background:var(--brand-dark)}
  .site-foot{border-top:1px solid var(--line); background:var(--panel); margin-top:34px; padding:22px 0 32px; text-align:center; color:var(--muted); font-size:13px}
  .site-foot b{color:var(--text-soft)}
  .site-foot a{color:var(--text-soft)}
</style>
</head>
<body>

<Header />

<div class="wrap">
<article class="art">
  <div class="crumb"><a href="/blog">← Blog</a></div>
  <h1>{title}</h1>
  <div class="meta">Blog Lê Chung · Kinh nghiệm thuê xe &amp; chở hàng{thoiGianDoc ? ` · Đọc khoảng ${thoiGianDoc} phút` : ''}</div>

  <img class="bai-anh" src={ANH_DAI_DIEN} alt={title} width="760" height="428" loading="eager" />

  <slot />

  <div class="cta-box">
    <h3>Cần thuê xe tải chở hàng?</h3>
    <p>Lê Chung — báo giá nhanh, có xe ngay, tài xế chuyên nghiệp. Gọi là có người tư vấn.</p>
    <a class="go" href="tel:0839861499">📞 Gọi ngay 0839 861 499</a>
  </div>
</article>
</div>

<footer class="site-foot">
  <div class="wrap">
    <b>LÊ CHUNG</b> · Dịch vụ xe tải chở hàng · Hotline: <span class="tnum">0839 861 499</span><br>
    © 2026 <b>lechung.vn</b> · <a href="/">Trang chủ</a> · <a href="/blog">Blog</a>
  </div>
</footer>

<!-- Dữ liệu cho Google: Bài viết (Article) + Đường dẫn (Breadcrumb) — giúp hiển thị đẹp trên kết quả tìm kiếm -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

</body>
</html>
